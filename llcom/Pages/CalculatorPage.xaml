<Page
  x:Class="llcom.Pages.CalculatorPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fa="http://schemas.fontawesome.io/icons/"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DesignHeight="560"
  d:DesignWidth="400"
  mc:Ignorable="d"
  Title="CalculatorPage"
>
  <Page.Resources>
    <!--  卡片  -->
    <Style x:Key="CalculatorCard" TargetType="{x:Type Border}">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!--  分段选择（位宽 / 大小端）  -->
    <Style x:Key="SegmentRadio" TargetType="{x:Type RadioButton}">
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Border
              x:Name="Bd"
              Padding="10,3"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}"
              BorderThickness="1"
              CornerRadius="4"
              SnapsToDevicePixels="True"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Foreground.Muted}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface.Muted}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Foreground.Muted}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  只读数值展示框：无边框、等宽字体、可选中复制  -->
    <Style x:Key="ValueBox" TargetType="{x:Type TextBox}">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  分组小标题  -->
    <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Muted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!--  进制标签  -->
    <Style x:Key="BaseLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Muted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CopyButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FlatIconButton}">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTip" Value="{DynamicResource CalculatorCopy}" />
    </Style>
  </Page.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8" TextElement.Foreground="{DynamicResource Brush.Foreground}">

      <!--  输入  -->
      <Border Style="{StaticResource CalculatorCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource CalculatorInput}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
              x:Name="InputBaseBox"
              Width="82"
              Height="28"
              Margin="0,0,6,0"
              SelectionChanged="InputBase_SelectionChanged"
              VerticalContentAlignment="Center"
            >
              <ComboBoxItem Content="HEX" Tag="16" />
              <ComboBoxItem Content="DEC" Tag="10" />
              <ComboBoxItem Content="OCT" Tag="8" />
              <ComboBoxItem Content="BIN" Tag="2" />
            </ComboBox>
            <TextBox
              x:Name="InputBox"
              Grid.Column="1"
              Height="28"
              VerticalContentAlignment="Center"
              CharacterCasing="Upper"
              FontFamily="Consolas"
              FontSize="13"
              TextChanged="InputBox_TextChanged"
            />
          </Grid>
          <TextBlock
            x:Name="InputErrorText"
            Margin="0,4,0,0"
            FontSize="11"
            Foreground="{DynamicResource Brush.State.Error}"
            Text="{DynamicResource CalculatorInvalid}"
            Visibility="Collapsed"
          />
        </StackPanel>
      </Border>

      <!--  位宽  -->
      <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
        <TextBlock
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          Foreground="{DynamicResource Brush.Foreground.Muted}"
          Text="{DynamicResource CalculatorWidth}"
        />
        <RadioButton
          x:Name="Width8Radio"
          Checked="Width_Checked"
          Content="{DynamicResource CalculatorBits8}"
          GroupName="CalculatorWidth"
          Style="{StaticResource SegmentRadio}"
          Tag="8"
        />
        <RadioButton
          x:Name="Width16Radio"
          Checked="Width_Checked"
          Content="{DynamicResource CalculatorBits16}"
          GroupName="CalculatorWidth"
          Style="{StaticResource SegmentRadio}"
          Tag="16"
        />
        <RadioButton
          x:Name="Width32Radio"
          Checked="Width_Checked"
          Content="{DynamicResource CalculatorBits32}"
          GroupName="CalculatorWidth"
          Style="{StaticResource SegmentRadio}"
          Tag="32"
        />
        <RadioButton
          x:Name="Width64Radio"
          Checked="Width_Checked"
          Content="{DynamicResource CalculatorBits64}"
          GroupName="CalculatorWidth"
          Style="{StaticResource SegmentRadio}"
          Tag="64"
        />
      </StackPanel>

      <!--  多进制同步显示  -->
      <Border Style="{StaticResource CalculatorCard}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="42" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock
            Grid.Row="0"
            Style="{StaticResource BaseLabel}"
            Text="HEX"
          />
          <TextBox
            x:Name="HexBox"
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,2"
            Style="{StaticResource ValueBox}"
          />
          <Button
            Grid.Row="0"
            Grid.Column="2"
            Click="CopyValue_Click"
            Style="{StaticResource CopyButton}"
            Tag="{Binding ElementName=HexBox}"
          >
            <fa:FontAwesome FontSize="11" Icon="Copy" />
          </Button>

          <TextBlock
            Grid.Row="1"
            Style="{StaticResource BaseLabel}"
            Text="DEC"
          />
          <TextBox
            x:Name="DecBox"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,2"
            Style="{StaticResource ValueBox}"
          />
          <Button
            Grid.Row="1"
            Grid.Column="2"
            Click="CopyValue_Click"
            Style="{StaticResource CopyButton}"
            Tag="{Binding ElementName=DecBox}"
          >
            <fa:FontAwesome FontSize="11" Icon="Copy" />
          </Button>

          <TextBlock
            Grid.Row="2"
            Style="{StaticResource BaseLabel}"
            Text="OCT"
          />
          <TextBox
            x:Name="OctBox"
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,2"
            Style="{StaticResource ValueBox}"
          />
          <Button
            Grid.Row="2"
            Grid.Column="2"
            Click="CopyValue_Click"
            Style="{StaticResource CopyButton}"
            Tag="{Binding ElementName=OctBox}"
          >
            <fa:FontAwesome FontSize="11" Icon="Copy" />
          </Button>

          <TextBlock
            Grid.Row="3"
            Style="{StaticResource BaseLabel}"
            Text="BIN"
          />
          <TextBox
            x:Name="BinBox"
            Grid.Row="3"
            Grid.Column="1"
            Margin="0,2"
            Style="{StaticResource ValueBox}"
          />
          <Button
            Grid.Row="3"
            Grid.Column="2"
            Click="CopyValue_Click"
            Style="{StaticResource CopyButton}"
            Tag="{Binding ElementName=BinBox}"
          >
            <fa:FontAwesome FontSize="11" Icon="Copy" />
          </Button>
        </Grid>
      </Border>

      <!--  位运算  -->
      <Border Style="{StaticResource CalculatorCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource CalculatorBitOps}" />
          <WrapPanel Orientation="Horizontal">
            <TextBlock
              Margin="0,0,4,0"
              VerticalAlignment="Center"
              FontSize="11"
              Foreground="{DynamicResource Brush.Foreground.Muted}"
              Text="{DynamicResource CalculatorOperand}"
            />
            <TextBox
              x:Name="OperandBox"
              Width="64"
              Height="28"
              Margin="0,0,4,4"
              VerticalContentAlignment="Center"
              CharacterCasing="Upper"
              FontFamily="Consolas"
              FontSize="12"
            />
            <Button
              Width="28"
              Height="28"
              Margin="0,0,2,4"
              Click="BitOp_Click"
              Content="&lt;&lt;"
              Tag="shl"
            />
            <Button
              Width="28"
              Height="28"
              Margin="0,0,2,4"
              Click="BitOp_Click"
              Content="&gt;&gt;"
              Tag="shr"
            />
            <Button
              Width="28"
              Height="28"
              Margin="0,0,2,4"
              Click="BitOp_Click"
              Content="&amp;"
              Tag="and"
            />
            <Button
              Width="28"
              Height="28"
              Margin="0,0,2,4"
              Click="BitOp_Click"
              Content="|"
              Tag="or"
            />
            <Button
              Width="28"
              Height="28"
              Margin="0,0,2,4"
              Click="BitOp_Click"
              Content="^"
              Tag="xor"
            />
            <Button
              Width="28"
              Height="28"
              Margin="0,0,0,4"
              Click="BitOp_Click"
              Content="~"
              Tag="not"
            />
          </WrapPanel>
          <TextBlock
            Margin="0,2,0,0"
            FontSize="11"
            Foreground="{DynamicResource Brush.Foreground.Subtle}"
            Text="{DynamicResource CalculatorBitOpsHint}"
            TextWrapping="Wrap"
          />
        </StackPanel>
      </Border>

      <!--  浮点数  -->
      <Border Style="{StaticResource CalculatorCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource CalculatorFloat}" />
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="58" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource BaseLabel}" Text="FLOAT32" />
            <TextBox
              x:Name="Float32Input"
              Grid.Column="1"
              MaxLength="8"
              Height="26"
              Margin="0,0,0,2"
              VerticalContentAlignment="Center"
              FontFamily="Consolas"
              TextChanged="FloatInput_TextChanged"
            />
            <TextBlock
              Grid.Row="1"
              Margin="0,0,6,0"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Foreground="{DynamicResource Brush.Foreground.Muted}"
              Text="→"
            />
            <TextBox
              x:Name="Float32Result"
              Grid.Row="1"
              Grid.Column="1"
              MinHeight="20"
              Style="{StaticResource ValueBox}"
            />
          </Grid>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="58" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource BaseLabel}" Text="FLOAT64" />
            <TextBox
              x:Name="Float64Input"
              Grid.Column="1"
              MaxLength="16"
              Height="26"
              Margin="0,0,0,2"
              VerticalContentAlignment="Center"
              FontFamily="Consolas"
              TextChanged="FloatInput_TextChanged"
            />
            <TextBlock
              Grid.Row="1"
              Margin="0,0,6,0"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Foreground="{DynamicResource Brush.Foreground.Muted}"
              Text="→"
            />
            <TextBox
              x:Name="Float64Result"
              Grid.Row="1"
              Grid.Column="1"
              MinHeight="20"
              Style="{StaticResource ValueBox}"
            />
          </Grid>
          <StackPanel Orientation="Horizontal">
            <RadioButton
              x:Name="BigEndianRadio"
              Checked="Endian_Checked"
              Content="{DynamicResource CalculatorBigEndian}"
              GroupName="CalculatorEndian"
              Style="{StaticResource SegmentRadio}"
            />
            <RadioButton
              x:Name="LittleEndianRadio"
              Checked="Endian_Checked"
              Content="{DynamicResource CalculatorLittleEndian}"
              GroupName="CalculatorEndian"
              Style="{StaticResource SegmentRadio}"
            />
          </StackPanel>
          <TextBlock
            Margin="0,4,0,0"
            FontSize="11"
            Foreground="{DynamicResource Brush.Foreground.Subtle}"
            Text="{DynamicResource CalculatorEndianHint}"
            TextWrapping="Wrap"
          />
        </StackPanel>
      </Border>

      <!--  计算器（四则运算）  -->
      <Border Style="{StaticResource CalculatorCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource CalculatorArithmetic}" />
          <TextBox
            x:Name="ExpressionBox"
            Height="28"
            VerticalContentAlignment="Center"
            FontFamily="Consolas"
            FontSize="13"
            TextChanged="ExpressionBox_TextChanged"
          />
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Margin="0,0,8,0"
              VerticalAlignment="Center"
              FontSize="11"
              Foreground="{DynamicResource Brush.Foreground.Muted}"
              Text="{DynamicResource CalculatorResult}"
            />
            <TextBox
              x:Name="ExpressionResult"
              Grid.Column="1"
              Style="{StaticResource ValueBox}"
              Text="—"
            />
            <Button
              Grid.Column="2"
              Click="CopyValue_Click"
              Style="{StaticResource CopyButton}"
              Tag="{Binding ElementName=ExpressionResult}"
            >
              <fa:FontAwesome FontSize="11" Icon="Copy" />
            </Button>
          </Grid>
          <TextBlock
            x:Name="ExpressionErrorText"
            Margin="0,4,0,0"
            FontSize="11"
            Foreground="{DynamicResource Brush.State.Error}"
            Text="{DynamicResource CalculatorExpressionInvalid}"
            Visibility="Collapsed"
          />
          <TextBlock
            Margin="0,4,0,0"
            FontSize="11"
            Foreground="{DynamicResource Brush.Foreground.Subtle}"
            Text="{DynamicResource CalculatorExpressionHint}"
            TextWrapping="Wrap"
          />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>