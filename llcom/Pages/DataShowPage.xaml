<Page
  x:Class="llcom.Pages.DataShowPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fa="http://schemas.fontawesome.io/icons/"
  xmlns:local="clr-namespace:llcom.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="DataShowPage"
  adonisExtensions:RippleExtension.FadeInDuration="0"
  adonisExtensions:RippleExtension.FadeOutDuration="0"
  d:DesignHeight="450"
  d:DesignWidth="800"
  Loaded="Page_Loaded"
  mc:Ignorable="d"
>
  <Grid x:Name="mainGrid" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBox
      Name="MainTextBox"
      VerticalContentAlignment="Top"
      Background="Transparent"
      BorderThickness="0"
      FontFamily="Consolas,Microsoft YaHei,微软雅黑"
      FontSize="{Binding Setting.logFontSize}"
      Foreground="{DynamicResource Brush.Data.Received}"
      IsReadOnly="True"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      TextWrapping="Wrap"
    />
    <ScrollViewer Name="MainListScrollViewer" VerticalScrollBarVisibility="Auto">
      <ItemsControl
        Name="MainList"
        Background="Transparent"
        ItemsSource="{Binding Items}"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        ScrollViewer.VerticalScrollBarVisibility="Auto"
        VirtualizingStackPanel.CacheLength="2,2"
        VirtualizingStackPanel.IsVirtualizing="True"
        VirtualizingStackPanel.VirtualizationMode="Recycling"
      >
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RichTextBox
              Background="Transparent"
              BorderThickness="0"
              FontFamily="Consolas,Microsoft YaHei,微软雅黑"
              FontSize="{Binding DataContext.Setting.logFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              IsReadOnly="True"
            >
              <FlowDocument>
                <Paragraph Margin="0">
                  <Run Foreground="{DynamicResource Brush.Log.Time}" Text="{Binding TimeText, Mode=OneWay}" />
                  <Run Foreground="{DynamicResource Brush.Log.Time}" Text="{Binding ArrowText, Mode=OneWay}" />
                  <Run Foreground="{Binding DataTextColor}" Text="{Binding DataText, Mode=OneWay}" />
                  <Run FontWeight="Bold" Foreground="{DynamicResource Brush.Foreground}" Text="{Binding RawTitle, Mode=OneWay}" />
                  <Run Foreground="{Binding RawTextColor}" Text="{Binding RawText, Mode=OneWay}" />
                </Paragraph>
              </FlowDocument>
            </RichTextBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <WrapPanel
      Grid.Row="1"
      Margin="10,0,0,3"
      HorizontalAlignment="Left"
      VerticalAlignment="Bottom"
      Orientation="Horizontal"
    >
      <!--  发送显示方式：Abc（字符串）/ Hex  -->
      <ToggleButton
        Name="SendHexToggle"
        AutomationProperties.Name="{DynamicResource HexSendMode}"
        IsChecked="{Binding Setting.hexSend}"
        Style="{StaticResource LogBarToggle}"
        ToolTip="{DynamicResource SendHexToggleTip}"
      />
      <!--  接收显示方式：Abc（字符串）/ Hex  -->
      <ToggleButton
        Name="RecvHexToggle"
        AutomationProperties.Name="{DynamicResource RecvHexView}"
        IsChecked="{Binding Setting.recvShowHex}"
        Style="{StaticResource LogBarToggle}"
        ToolTip="{DynamicResource RecvHexToggleTip}"
      />
      <!--  替换不可见字符  -->
      <ToggleButton
        Name="ShowSymbolToggle"
        AutomationProperties.Name="{DynamicResource ShowSymbol}"
        IsChecked="{Binding Setting.EnableSymbol}"
        Style="{StaticResource LogBarIconToggle}"
        ToolTip="{DynamicResource ShowSymbolIconTip}"
      >
        <fa:FontAwesome FontSize="14" Icon="Eye" />
      </ToggleButton>
      <!--  停止打印 / 继续打印  -->
      <ToggleButton
        Name="DisableLogToggle"
        AutomationProperties.Name="{DynamicResource DisableLog}"
        IsChecked="{Binding Setting.DisableLog}"
        Style="{StaticResource LogBarIconToggle}"
        ToolTip="{DynamicResource DisableLogIconTip}"
      >
        <Grid>
          <fa:FontAwesome
            FontSize="14"
            Icon="Pause"
            Visibility="{Binding Setting.DisableLog, Converter={StaticResource boolNotVisibeConverter}}"
          />
          <fa:FontAwesome
            FontSize="14"
            Icon="Play"
            Visibility="{Binding Setting.DisableLog, Converter={StaticResource boolVisibeConverter}}"
          />
        </Grid>
      </ToggleButton>
      <!--  锁定视图禁止滚动  -->
      <Button
        Name="LockLogButton"
        Style="{StaticResource LogBarButton}"
        AutomationProperties.Name="{DynamicResource LockLogButton}"
        Click="LockLogButton_Click"
        ToolTip="{DynamicResource LockLogButton}"
      >
        <Grid>
          <fa:FontAwesome
            FontSize="14"
            Icon="Lock"
            Visibility="{Binding LockLog, Converter={StaticResource boolNotVisibeConverter}}"
          />
          <fa:FontAwesome
            FontSize="14"
            Foreground="{DynamicResource Brush.State.Success}"
            Icon="Unlock"
            Visibility="{Binding LockLog, Converter={StaticResource boolVisibeConverter}}"
          />
        </Grid>
      </Button>
    </WrapPanel>
    <Button
      Name="SaveLogButton"
      Margin="0,0,18,3"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom"
      Click="SaveLogButton_Click"
      ToolTip="{DynamicResource SaveLogButton}"
      Visibility="{Binding Path=IsMouseOver, ElementName=mainGrid, Converter={StaticResource boolVisibeConverter}}"
      BorderBrush="{DynamicResource Brush.Foreground}"
    >
      <fa:FontAwesome Icon="Save" HorizontalAlignment="Center" FontSize="12" />
    </Button>
  </Grid>
</Page>
