<Page
  x:Class="llcom.Pages.DataShowPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fa="http://schemas.fontawesome.io/icons/"
  xmlns:local="clr-namespace:llcom.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="DataShowPage"
  adonisExtensions:RippleExtension.FadeInDuration="0"
  adonisExtensions:RippleExtension.FadeOutDuration="0"
  d:DesignHeight="450"
  d:DesignWidth="800"
  Loaded="Page_Loaded"
  mc:Ignorable="d"
>
  <Grid x:Name="mainGrid" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBox
      Name="MainTextBox"
      VerticalContentAlignment="Top"
      Background="Transparent"
      BorderThickness="0"
      FontFamily="Consolas,Microsoft YaHei,微软雅黑"
      FontSize="{Binding Setting.logFontSize}"
      Foreground="{DynamicResource Brush.Data.Received}"
      IsReadOnly="True"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      TextWrapping="Wrap"
    />
    <ListBox
      Name="MainList"
      Background="Transparent"
      BorderThickness="0"
      ItemsSource="{Binding Items}"
      ScrollViewer.CanContentScroll="True"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      SelectionMode="Single"
      VirtualizingStackPanel.CacheLength="1,1"
      VirtualizingStackPanel.IsVirtualizing="True"
      VirtualizingStackPanel.VirtualizationMode="Recycling"
      VirtualizingPanel.ScrollUnit="Pixel"
    >
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Focusable" Value="False" />
          <Setter Property="IsTabStop" Value="False" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Stretch" />
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <RichTextBox
            Background="Transparent"
            BorderThickness="0"
            FontFamily="Consolas,Microsoft YaHei,微软雅黑"
            FontSize="{Binding DataContext.Setting.logFontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
            IsReadOnly="True"
          >
            <FlowDocument>
              <Paragraph Margin="0">
                <Run Foreground="{DynamicResource Brush.Log.Time}" Text="{Binding TimeText, Mode=OneWay}" />
                <Run Foreground="{DynamicResource Brush.Log.Time}" Text="{Binding ArrowText, Mode=OneWay}" />
                <Run Foreground="{Binding DataTextColor}" Text="{Binding DataText, Mode=OneWay}" />
                <Run FontWeight="Bold" Foreground="{DynamicResource Brush.Foreground}" Text="{Binding RawTitle, Mode=OneWay}" />
                <Run Foreground="{Binding RawTextColor}" Text="{Binding RawText, Mode=OneWay}" />
              </Paragraph>
            </FlowDocument>
          </RichTextBox>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel
      Grid.Row="1"
      Margin="10,0,0,3"
      HorizontalAlignment="Left"
      VerticalAlignment="Bottom"
      Orientation="Horizontal"
    >
      <!--  发送显示方式：Abc（字符串）/ Hex  -->
      <ToggleButton
        Name="SendHexToggle"
        AutomationProperties.Name="{DynamicResource HexSendMode}"
        IsChecked="{Binding Setting.hexSend}"
        Style="{StaticResource SendHexToggleStyle}"
      />
      <!--  接收显示方式：Abc（字符串）/ Hex  -->
      <ToggleButton
        Name="RecvHexToggle"
        AutomationProperties.Name="{DynamicResource RecvHexView}"
        IsChecked="{Binding Setting.recvShowHex}"
        Style="{StaticResource RecvHexToggleStyle}"
      />
      <!--  替换不可见字符  -->
      <ToggleButton
        Name="ShowSymbolToggle"
        AutomationProperties.Name="{DynamicResource ShowSymbol}"
        IsChecked="{Binding Setting.EnableSymbol}"
        Style="{StaticResource LogBarIconToggle}"
        ToolTip="{DynamicResource ShowSymbolIconTip}"
      >
        <fa:FontAwesome FontSize="14" Icon="Eye" />
      </ToggleButton>
      <!--  停止打印 / 继续打印  -->
      <ToggleButton
        Name="DisableLogToggle"
        AutomationProperties.Name="{DynamicResource DisableLog}"
        IsChecked="{Binding Setting.DisableLog}"
        Style="{StaticResource LogBarIconToggle}"
        ToolTip="{DynamicResource DisableLogIconTip}"
      >
        <Grid>
          <fa:FontAwesome
            FontSize="14"
            Icon="Pause"
            Visibility="{Binding Setting.DisableLog, Converter={StaticResource boolNotVisibeConverter}}"
          />
          <fa:FontAwesome
            FontSize="14"
            Icon="Play"
            Visibility="{Binding Setting.DisableLog, Converter={StaticResource boolVisibeConverter}}"
          />
        </Grid>
      </ToggleButton>
      <!--  锁定视图禁止滚动  -->
      <Button
        Name="LockLogButton"
        Style="{StaticResource LogBarButton}"
        AutomationProperties.Name="{DynamicResource LockLogButton}"
        Click="LockLogButton_Click"
        ToolTip="{DynamicResource LockLogButton}"
      >
        <Grid>
          <fa:FontAwesome
            FontSize="14"
            Icon="Lock"
            Visibility="{Binding LockLog, Converter={StaticResource boolNotVisibeConverter}}"
          />
          <fa:FontAwesome
            FontSize="14"
            Foreground="{DynamicResource Brush.State.Success}"
            Icon="Unlock"
            Visibility="{Binding LockLog, Converter={StaticResource boolVisibeConverter}}"
          />
        </Grid>
      </Button>
      <!--  清空日志  -->
      <Button
        Name="ClearLogButton"
        Style="{StaticResource LogBarButton}"
        AutomationProperties.Name="{DynamicResource ClearLog}"
        Click="ClearLogButton_Click"
        ToolTip="{DynamicResource ClearLog}"
      >
        <fa:FontAwesome FontSize="14" Icon="Trash" />
      </Button>
      <!--  保存日志  -->
      <Button
        Name="SaveLogButton"
        Style="{StaticResource LogBarButton}"
        AutomationProperties.Name="{DynamicResource SaveLogButton}"
        Click="SaveLogButton_Click"
        ToolTip="{DynamicResource SaveLogButton}"
      >
        <fa:FontAwesome FontSize="14" Icon="Save" />
      </Button>
    </WrapPanel>
  </Grid>
</Page>
