<Page
  x:Class="llcom.Pages.Dlt645Page"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fa="http://schemas.fontawesome.io/icons/"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="DL/T 645-2007"
  d:DesignHeight="620"
  d:DesignWidth="720"
  Loaded="Page_Loaded"
  Unloaded="Page_Unloaded"
  adonisExtensions:RippleExtension.FadeInDuration="0"
  adonisExtensions:RippleExtension.FadeOutDuration="0"
  mc:Ignorable="d"
>
  <Page.Resources>
    <Style x:Key="Dlt645Card" TargetType="Border">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="RoundStatusButton" TargetType="Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Muted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="15"
            >
              <ContentPresenter
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
              />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8">

      <!--  参数区  -->
      <Border Style="{StaticResource Dlt645Card}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="72" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
              Margin="0,0,6,6"
              VerticalAlignment="Center"
              Style="{StaticResource Tool.SectionLabel}"
              Text="{DynamicResource Dlt645Address}"
            />
            <TextBox
              Name="AddressTextBox"
              Grid.Column="1"
              Height="28"
              Margin="0,0,0,6"
              VerticalContentAlignment="Center"
              FontFamily="Consolas"
              KeyDown="AddressTextBox_KeyDown"
              LostFocus="AddressTextBox_LostFocus"
              MaxLength="12"
              Text="000000000001"
              TextChanged="Input_Changed"
              ToolTip="{DynamicResource Dlt645AddressTip}"
            />
            <Button
              Name="ReadAddressButton"
              Grid.Column="2"
              Margin="6,0,0,6"
              Click="ReadAddressButton_Click"
              Style="{StaticResource RoundStatusButton}"
              ToolTip="{DynamicResource Dlt645ReadAddressButton}"
            >
              <fa:FontAwesome FontSize="13" Icon="Search" />
            </Button>

            <TextBlock
              Grid.Row="1"
              Margin="0,0,6,6"
              VerticalAlignment="Center"
              Style="{StaticResource Tool.SectionLabel}"
              Text="{DynamicResource Dlt645Preamble}"
            />
            <StackPanel
              Grid.Row="1"
              Grid.Column="1"
              Grid.ColumnSpan="2"
              Margin="0,0,0,6"
              Orientation="Horizontal"
            >
              <ComboBox
                Name="PreambleComboBox"
                Width="50"
                Height="28"
                SelectionChanged="Input_SelectionChanged"
              />
              <CheckBox
                Name="DecodeDataCheckBox"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Checked="DecodeDataCheckBox_Changed"
                Content="{DynamicResource Dlt645DecodeData33}"
                IsChecked="False"
                ToolTip="{DynamicResource Dlt645DecodeData33Tip}"
                Unchecked="DecodeDataCheckBox_Changed"
              />
            </StackPanel>

            <TextBlock
              Grid.Row="2"
              Margin="0,0,6,6"
              VerticalAlignment="Center"
              Style="{StaticResource Tool.SectionLabel}"
              Text="{DynamicResource Dlt645Operation}"
            />
            <ComboBox
              Name="OperationComboBox"
              Grid.Row="2"
              Grid.Column="1"
              Grid.ColumnSpan="2"
              Height="28"
              Margin="0,0,0,6"
              SelectionChanged="OperationComboBox_SelectionChanged"
            />

            <TextBlock
              Grid.Row="3"
              Margin="0,0,6,6"
              VerticalAlignment="Center"
              Style="{StaticResource Tool.SectionLabel}"
              Text="{DynamicResource Dlt645DiFilter}"
            />
            <Grid
              Grid.Row="3"
              Grid.Column="1"
              Grid.ColumnSpan="2"
              Margin="0,0,0,6"
            >
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid>
                <TextBox
                  Name="DiSearchTextBox"
                  Height="28"
                  Padding="26,0,4,0"
                  VerticalContentAlignment="Center"
                  KeyDown="DiSearchTextBox_KeyDown"
                  TextChanged="DiFilter_Changed"
                  ToolTip="{DynamicResource Dlt645DiSearchTip}"
                />
                <fa:FontAwesome
                  Margin="7,0,0,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  FontSize="12"
                  Foreground="{DynamicResource Brush.Foreground.Muted}"
                  Icon="Search"
                  IsHitTestVisible="False"
                />
              </Grid>
              <ComboBox
                Name="DiCategoryComboBox"
                Grid.Column="1"
                Width="90"
                Height="28"
                Margin="6,0,0,0"
                SelectionChanged="DiFilter_Changed"
              />
              <Button
                Name="ManageDiButton"
                Grid.Column="2"
                Margin="6,0,0,0"
                Click="ManageDiButton_Click"
                Style="{StaticResource IconButton}"
                ToolTip="{DynamicResource Dlt645ManageDi}"
              >
                <fa:FontAwesome FontSize="14" Icon="Cog" />
              </Button>
            </Grid>

            <TextBlock
              Grid.Row="4"
              Margin="0,0,6,6"
              VerticalAlignment="Center"
              Style="{StaticResource Tool.SectionLabel}"
              Text="{DynamicResource Dlt645DataIdentifier}"
            />
            <Grid
              Grid.Row="4"
              Grid.Column="1"
              Grid.ColumnSpan="2"
              Margin="0,0,0,6"
            >
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox
                Name="DiComboBox"
                Height="28"
                MaxDropDownHeight="240"
                SelectionChanged="DiComboBox_SelectionChanged"
                ToolTip="{DynamicResource Dlt645DataIdentifierTip}"
              >
                <ComboBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem
                      Click="DeleteSelectedDi_Click"
                      Header="{DynamicResource Dlt645DeleteDi}"
                    />
                  </ContextMenu>
                </ComboBox.ContextMenu>
              </ComboBox>
              <TextBox
                Name="DiHexTextBox"
                Grid.Column="1"
                Width="80"
                Height="28"
                Margin="6,0,0,0"
                VerticalContentAlignment="Center"
                DataObject.Pasting="HexTextBox_Pasting"
                FontFamily="Consolas"
                MaxLength="8"
                PreviewTextInput="HexTextBox_PreviewTextInput"
                TextChanged="DiHexTextBox_TextChanged"
                ToolTip="{DynamicResource Dlt645DataIdentifierHexTip}"
              />
            </Grid>

            <TextBlock
              Name="ExtraDataLabel"
              Grid.Row="5"
              Margin="0,0,6,6"
              VerticalAlignment="Center"
              Style="{StaticResource Tool.SectionLabel}"
              Text="{DynamicResource Dlt645ExtraData}"
            />
            <TextBox
              Name="ExtraDataTextBox"
              Grid.Row="5"
              Grid.Column="1"
              Grid.ColumnSpan="2"
              Height="28"
              Margin="0,0,0,6"
              VerticalContentAlignment="Center"
              FontFamily="Consolas"
              TextChanged="Input_Changed"
              ToolTip="{DynamicResource Dlt645ExtraDataTip}"
            />

            <TextBlock
              Name="ControlCodeLabel"
              Grid.Row="6"
              Margin="0,0,6,6"
              VerticalAlignment="Center"
              Style="{StaticResource Tool.SectionLabel}"
              Text="{DynamicResource Dlt645ControlCode}"
              Visibility="Collapsed"
            />
            <TextBox
              Name="ControlCodeTextBox"
              Grid.Row="6"
              Grid.Column="1"
              Grid.ColumnSpan="2"
              Height="28"
              Margin="0,0,0,6"
              VerticalContentAlignment="Center"
              DataObject.Pasting="HexTextBox_Pasting"
              FontFamily="Consolas"
              MaxLength="2"
              PreviewTextInput="HexTextBox_PreviewTextInput"
              TextChanged="Input_Changed"
              ToolTip="{DynamicResource Dlt645ControlCodeTip}"
              Visibility="Collapsed"
            />

            <TextBlock
              Name="WriteParamsLabel"
              Grid.Row="7"
              Margin="0,0,6,6"
              VerticalAlignment="Center"
              Style="{StaticResource Tool.SectionLabel}"
              Text="{DynamicResource Dlt645WriteParams}"
              Visibility="Collapsed"
            />
            <CheckBox
              Name="AutoWriteInfoCheckBox"
              Grid.Row="7"
              Grid.Column="1"
              Grid.ColumnSpan="2"
              Margin="0,0,0,6"
              VerticalAlignment="Center"
              Checked="AutoWriteInfo_Changed"
              Content="{DynamicResource Dlt645AutoWriteInfo}"
              ToolTip="{DynamicResource Dlt645AutoWriteInfoTip}"
              Unchecked="AutoWriteInfo_Changed"
              Visibility="Collapsed"
            />
            <Grid
              Name="WriteParamsPanel"
              Grid.Row="8"
              Grid.Column="1"
              Grid.ColumnSpan="2"
              Margin="0,0,0,6"
              Visibility="Collapsed"
            >
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="70" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,6,6"
                VerticalAlignment="Center"
                Text="{DynamicResource Dlt645Password}"
              />
              <TextBox
                Name="PasswordTextBox"
                Grid.Row="0"
                Grid.Column="1"
                Width="74"
                Height="28"
                Margin="0,0,0,6"
                VerticalContentAlignment="Center"
                DataObject.Pasting="HexTextBox_Pasting"
                FontFamily="Consolas"
                MaxLength="8"
                PreviewTextInput="HexTextBox_PreviewTextInput"
                TextChanged="WriteInfoText_Changed"
                ToolTip="{DynamicResource Dlt645PasswordTip}"
              />

              <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                Text="{DynamicResource Dlt645OperatorCode}"
              />
              <TextBox
                Name="OperatorTextBox"
                Grid.Row="1"
                Grid.Column="1"
                Width="74"
                Height="28"
                VerticalContentAlignment="Center"
                DataObject.Pasting="HexTextBox_Pasting"
                FontFamily="Consolas"
                MaxLength="8"
                PreviewTextInput="HexTextBox_PreviewTextInput"
                TextChanged="WriteInfoText_Changed"
                ToolTip="{DynamicResource Dlt645OperatorCodeTip}"
              />
            </Grid>
          </Grid>

          <TextBlock
            Name="AddressHint"
            Margin="0,0,0,6"
            Foreground="{DynamicResource Brush.Foreground.Muted}"
            Text="{DynamicResource Dlt645ReadAddressHint}"
            TextWrapping="Wrap"
            Visibility="Collapsed"
          />

          <WrapPanel Margin="0,2,0,0">
            <Button
              Name="SendButton"
              MinWidth="76"
              Height="30"
              Click="SendButton_Click"
            >
              <StackPanel Orientation="Horizontal">
                <fa:FontAwesome
                  Margin="0,0,5,0"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource Brush.State.Success}"
                  Icon="PaperPlane"
                />
                <TextBlock Text="{DynamicResource Dlt645Send}" />
              </StackPanel>
            </Button>
            <Button
              Name="CopyButton"
              Margin="6,0,0,0"
              Click="CopyButton_Click"
              Style="{StaticResource IconButton}"
              ToolTip="{DynamicResource Dlt645Copy}"
            >
              <fa:FontAwesome Icon="Copy" />
            </Button>
            <Button
              Name="SendToMainBoxButton"
              Margin="6,0,0,0"
              Click="SendToMainBoxButton_Click"
              Style="{StaticResource IconButton}"
              ToolTip="{DynamicResource Dlt645SendToMainBox}"
            >
              <fa:FontAwesome Icon="ArrowUp" />
            </Button>
            <TextBlock
              Name="StatusText"
              Margin="10,0,0,0"
              VerticalAlignment="Center"
              Foreground="{DynamicResource Brush.Foreground.Muted}"
              TextWrapping="Wrap"
            />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!--  帧预览  -->
      <Border Style="{StaticResource Dlt645Card}">
        <StackPanel>
          <TextBlock
            Margin="0,0,0,6"
            FontWeight="Bold"
            Text="{DynamicResource Dlt645FramePreview}"
          />
          <TextBox
            Name="FramePreviewTextBox"
            MinHeight="48"
            MaxHeight="90"
            AcceptsReturn="True"
            FontFamily="Consolas"
            IsReadOnly="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
          />
          <TextBlock
            Name="FrameSummaryText"
            Margin="0,6,0,0"
            FontFamily="Consolas"
            Foreground="{DynamicResource Brush.Foreground.Muted}"
            TextWrapping="Wrap"
          />
        </StackPanel>
      </Border>

      <!--  应答解析  -->
      <Border Style="{StaticResource Dlt645Card}">
        <StackPanel>
          <TextBlock
            Margin="0,0,0,6"
            FontWeight="Bold"
            Text="{DynamicResource Dlt645ParseResponse}"
          />
          <TextBox
            Name="ResponseTextBox"
            MinHeight="52"
            MaxHeight="90"
            AcceptsReturn="True"
            FontFamily="Consolas"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
            ToolTip="{DynamicResource Dlt645PasteFrame}"
          />
          <WrapPanel Margin="0,6,0,0">
            <Button
              Name="ParseButton"
              MinWidth="72"
              Height="30"
              Click="ParseButton_Click"
              Content="{DynamicResource Dlt645Parse}"
            />
            <Button
              Name="UseAddressButton"
              MinWidth="96"
              Height="30"
              Margin="6,0,0,0"
              Click="UseAddressButton_Click"
              Content="{DynamicResource Dlt645UseParsedAddress}"
              Visibility="Collapsed"
            />
            <TextBlock
              Name="ParseStatusText"
              Margin="10,0,0,0"
              VerticalAlignment="Center"
              Foreground="{DynamicResource Brush.Foreground.Muted}"
              TextWrapping="Wrap"
            />
          </WrapPanel>
          <TextBox
            Name="ParseResultTextBox"
            MinHeight="110"
            Margin="0,6,0,0"
            AcceptsReturn="True"
            FontFamily="Consolas"
            IsReadOnly="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
          />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
