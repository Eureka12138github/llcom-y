<Page
  x:Class="llcom.Pages.Dlt645Page"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="DL/T 645-2007"
  d:DesignHeight="620"
  d:DesignWidth="720"
  Loaded="Page_Loaded"
  adonisExtensions:RippleExtension.FadeInDuration="0"
  adonisExtensions:RippleExtension.FadeOutDuration="0"
  mc:Ignorable="d"
>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid
      Grid.IsSharedSizeScope="True"
      Style="{StaticResource Tool.Content}"
    >
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!--  表地址 / 前导 FE  -->
      <Grid Grid.Row="0" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="Dlt645RowLabel" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Dlt645RowInput" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Dlt645RowLabel2" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock
          Margin="0,0,6,0"
          Style="{StaticResource Tool.SectionLabel}"
          Text="{DynamicResource Dlt645Address}"
        />
        <TextBox
          Name="AddressTextBox"
          Grid.Column="1"
          Width="108"
          Height="28"
          HorizontalAlignment="Left"
          VerticalContentAlignment="Center"
          FontFamily="Consolas"
          KeyDown="AddressTextBox_KeyDown"
          LostFocus="AddressTextBox_LostFocus"
          MaxLength="12"
          Text="000000000001"
          TextChanged="Input_Changed"
          ToolTip="{DynamicResource Dlt645AddressTip}"
        />
        <TextBlock
          Grid.Column="2"
          Margin="16,0,6,0"
          Style="{StaticResource Tool.SectionLabel}"
          Text="{DynamicResource Dlt645Preamble}"
        />
        <ComboBox
          Name="PreambleComboBox"
          Grid.Column="3"
          Width="60"
          Height="28"
          SelectionChanged="Input_SelectionChanged"
        />
      </Grid>

      <TextBlock
        Name="AddressHint"
        Grid.Row="0"
        Grid.ColumnSpan="5"
        Margin="0,34,0,0"
        Foreground="{DynamicResource Brush.Foreground.Muted}"
        Text="{DynamicResource Dlt645ReadAddressHint}"
        TextWrapping="Wrap"
        Visibility="Collapsed"
      />

      <!--  操作 / DI  -->
      <Grid Grid.Row="1" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="Dlt645RowLabel" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Dlt645RowInput" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Dlt645RowLabel2" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
          Margin="0,0,6,0"
          Style="{StaticResource Tool.SectionLabel}"
          Text="{DynamicResource Dlt645Operation}"
        />
        <ComboBox
          Name="OperationComboBox"
          Grid.Column="1"
          Width="140"
          Height="28"
          SelectionChanged="OperationComboBox_SelectionChanged"
        />
        <TextBlock
          Grid.Column="2"
          Margin="16,0,6,0"
          Style="{StaticResource Tool.SectionLabel}"
          Text="{DynamicResource Dlt645DataIdentifier}"
        />
        <ComboBox
          Name="DiComboBox"
          Grid.Column="3"
          Height="28"
          SelectionChanged="DiComboBox_SelectionChanged"
          ToolTip="{DynamicResource Dlt645DataIdentifierTip}"
        />
        <TextBox
          Name="DiHexTextBox"
          Grid.Column="4"
          Width="92"
          Height="28"
          Margin="6,0,0,0"
          VerticalContentAlignment="Center"
          DataObject.Pasting="HexTextBox_Pasting"
          FontFamily="Consolas"
          MaxLength="8"
          PreviewTextInput="HexTextBox_PreviewTextInput"
          TextChanged="DiHexTextBox_TextChanged"
          ToolTip="{DynamicResource Dlt645DataIdentifierHexTip}"
        />
      </Grid>

      <!--  写操作附加数据 / 自定义操作的数据域与控制码  -->
      <Grid Grid.Row="2" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
          Name="ExtraDataLabel"
          Margin="0,0,6,0"
          Style="{StaticResource Tool.SectionLabel}"
          Text="{DynamicResource Dlt645ExtraData}"
        />
        <TextBox
          Name="ExtraDataTextBox"
          Grid.Column="1"
          Height="28"
          VerticalContentAlignment="Center"
          FontFamily="Consolas"
          TextChanged="Input_Changed"
          ToolTip="{DynamicResource Dlt645ExtraDataTip}"
        />
        <TextBlock
          Name="ControlCodeLabel"
          Grid.Column="2"
          Margin="12,0,6,0"
          Style="{StaticResource Tool.SectionLabel}"
          Text="{DynamicResource Dlt645ControlCode}"
          Visibility="Collapsed"
        />
        <TextBox
          Name="ControlCodeTextBox"
          Grid.Column="3"
          Width="58"
          Height="28"
          VerticalContentAlignment="Center"
          DataObject.Pasting="HexTextBox_Pasting"
          FontFamily="Consolas"
          MaxLength="2"
          PreviewTextInput="HexTextBox_PreviewTextInput"
          TextChanged="Input_Changed"
          ToolTip="{DynamicResource Dlt645ControlCodeTip}"
          Visibility="Collapsed"
        />
      </Grid>

      <!--  操作按钮  -->
      <WrapPanel Grid.Row="3" Margin="0,0,0,8" Orientation="Horizontal">
        <Button
          Name="SendButton"
          MinWidth="72"
          Height="30"
          Click="SendButton_Click"
          Content="{DynamicResource Dlt645Send}"
        />
        <Button
          Name="CopyButton"
          MinWidth="72"
          Height="30"
          Margin="6,0,0,0"
          Click="CopyButton_Click"
          Content="{DynamicResource Dlt645Copy}"
        />
        <TextBlock
          Name="StatusText"
          Margin="10,0,0,0"
          VerticalAlignment="Center"
          Foreground="{DynamicResource Brush.Foreground.Muted}"
          TextWrapping="Wrap"
        />
      </WrapPanel>

      <!--  帧预览  -->
      <Border
        Grid.Row="4"
        Margin="0,0,0,8"
        Padding="8"
        Background="{DynamicResource Brush.Surface.Subtle}"
        BorderBrush="{DynamicResource Brush.Border.Subtle}"
        BorderThickness="1"
        CornerRadius="4"
      >
        <StackPanel>
          <TextBlock
            Margin="0,0,0,4"
            FontWeight="Bold"
            Text="{DynamicResource Dlt645FramePreview}"
          />
          <TextBox
            Name="FramePreviewTextBox"
            MinHeight="48"
            MaxHeight="90"
            AcceptsReturn="True"
            FontFamily="Consolas"
            IsReadOnly="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
          />
          <TextBlock
            Name="FrameSummaryText"
            Margin="0,4,0,0"
            FontFamily="Consolas"
            Foreground="{DynamicResource Brush.Foreground.Muted}"
            TextWrapping="Wrap"
          />
        </StackPanel>
      </Border>

      <!--  应答解析  -->
      <Border
        Grid.Row="5"
        Padding="8"
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.Border.Subtle}"
        BorderThickness="1"
        CornerRadius="4"
      >
        <StackPanel>
          <TextBlock
            Margin="0,0,0,4"
            FontWeight="Bold"
            Text="{DynamicResource Dlt645ParseResponse}"
          />
          <TextBox
            Name="ResponseTextBox"
            MinHeight="52"
            MaxHeight="90"
            AcceptsReturn="True"
            FontFamily="Consolas"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
            ToolTip="{DynamicResource Dlt645PasteFrame}"
          />
          <WrapPanel Margin="0,6,0,0" Orientation="Horizontal">
            <Button
              Name="ParseButton"
              MinWidth="72"
              Height="30"
              Click="ParseButton_Click"
              Content="{DynamicResource Dlt645Parse}"
            />
            <Button
              Name="UseAddressButton"
              MinWidth="96"
              Height="30"
              Margin="6,0,0,0"
              Click="UseAddressButton_Click"
              Content="{DynamicResource Dlt645UseParsedAddress}"
              Visibility="Collapsed"
            />
            <TextBlock
              Name="ParseStatusText"
              Margin="10,0,0,0"
              VerticalAlignment="Center"
              Foreground="{DynamicResource Brush.Foreground.Muted}"
              TextWrapping="Wrap"
            />
          </WrapPanel>
          <TextBox
            Name="ParseResultTextBox"
            MinHeight="120"
            Margin="0,6,0,0"
            AcceptsReturn="True"
            FontFamily="Consolas"
            IsReadOnly="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
          />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Page>
