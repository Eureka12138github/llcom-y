<Page
  x:Class="llcom.Pages.OnlineScriptsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fa="http://schemas.fontawesome.io/icons/"
  xmlns:local="clr-namespace:llcom.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="OnlineScriptsPage"
  adonisExtensions:RippleExtension.FadeInDuration="0"
  adonisExtensions:RippleExtension.FadeOutDuration="0"
  d:DesignHeight="480"
  d:DesignWidth="400"
  Loaded="Page_Loaded"
  PreviewKeyDown="Page_PreviewKeyDown"
  mc:Ignorable="d"
>
  <Page.Resources>
    <!--  脚本来源切换：两个紧凑的按钮式单选，选中项用强调色描边  -->
    <Style x:Key="OnlineScriptSourceButton" TargetType="{x:Type ToggleButton}">
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Border
              x:Name="SourceBorder"
              Padding="{TemplateBinding Padding}"
              Background="Transparent"
              BorderBrush="{DynamicResource Brush.Border.Subtle}"
              BorderThickness="1"
              CornerRadius="3"
            >
              <ContentPresenter
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
              />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SourceBorder" Property="Background" Value="{DynamicResource Brush.Surface.Muted}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SourceBorder" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                <Setter TargetName="SourceBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Teal}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid>
    <Grid>
      <Grid Visibility="{Binding IsInList, Converter={StaticResource boolVisibeConverter}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="40" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
          HorizontalAlignment="Center"
          FontSize="22"
          Text="{DynamicResource OnlineScriptTitle}"
        />
        <Button
          Name="RefreshButton"
          Margin="5"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Click="RefreshButton_Click"
          ToolTip="{DynamicResource OnlineScriptRefresh}"
        >
          <Button.Content>
            <fa:FontAwesome Width="20" Height="20" FontSize="20" Foreground="{DynamicResource Brush.Foreground}" Icon="undo" />
          </Button.Content>
        </Button>
        <StackPanel
          Margin="0,0,4,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Orientation="Horizontal"
        >
          <Button
            Name="InfoButton"
            Margin="4"
            Click="InfoButton_Click"
            ToolTip="{DynamicResource OnlineScriptInfo}"
          >
            <Button.Content>
              <fa:FontAwesome Width="20" Height="20" FontSize="20" Foreground="{DynamicResource Brush.Foreground}" Icon="Info" />
            </Button.Content>
          </Button>
          <Button
            Name="SubmitButton"
            Margin="4"
            Click="SubmitButton_Click"
            ToolTip="{DynamicResource OnlineScriptSubmit}"
          >
            <Button.Content>
              <fa:FontAwesome Width="20" Height="20" FontSize="20" Foreground="{DynamicResource Brush.Accent.Teal}" Icon="PaperPlane" />
            </Button.Content>
          </Button>
        </StackPanel>

        <WrapPanel
          Grid.Row="1"
          Margin="4,0,4,4"
          HorizontalAlignment="Center"
          Orientation="Horizontal"
        >
          <ToggleButton
            Name="OfficialSourceButton"
            Content="{DynamicResource OnlineScriptSourceOfficial}"
            Click="SourceButton_Click"
            Style="{StaticResource OnlineScriptSourceButton}"
            ToolTip="{DynamicResource OnlineScriptSourceOfficialTip}"
          />
          <ToggleButton
            Name="ProjectSourceButton"
            Content="{DynamicResource OnlineScriptSourceProject}"
            Click="SourceButton_Click"
            Style="{StaticResource OnlineScriptSourceButton}"
            ToolTip="{DynamicResource OnlineScriptSourceProjectTip}"
          />
        </WrapPanel>

        <ScrollViewer Grid.Row="2" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="ScriptListItemsControl">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button
                  MinHeight="64"
                  Margin="0,2"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Center"
                  Background="{DynamicResource Brush.Surface}"
                  Click="Button_Click"
                  Tag="{Binding}"
                >
                  <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--  作者（自适应宽度） / 脚本名（占剩余宽度，加粗）  -->
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MaxWidth="120" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="{Binding Author}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Author}"
                      />
                      <TextBlock
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Name}"
                      />
                    </Grid>
                    <Border
                      Grid.Row="1"
                      Height="1"
                      Margin="0,6"
                      Background="{DynamicResource Brush.Border.Subtle}"
                    />
                    <!--  版本 / 简介  -->
                    <Grid Grid.Row="2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource Brush.Foreground.Muted}"
                        Text="{Binding Version, StringFormat=v{0}}"
                      />
                      <TextBlock
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource Brush.Foreground.Subtle}"
                        Text="{Binding Description}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Description}"
                      />
                    </Grid>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock
          Grid.Row="2"
          Margin="16"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          FontSize="16"
          Foreground="{DynamicResource Brush.Foreground.Muted}"
          Text="{Binding ListStateText}"
          TextAlignment="Center"
          TextWrapping="Wrap"
          Visibility="{Binding HasListState, Converter={StaticResource boolVisibeConverter}}"
        />

        <!--  加载遮罩只覆盖列表区域，来源切换按钮始终可用  -->
        <Grid
          Grid.Row="2"
          Background="{DynamicResource Brush.Surface}"
          Visibility="{Binding IsLoding, Converter={StaticResource boolVisibeConverter}}"
        >
          <StackPanel VerticalAlignment="Center">
            <TextBlock
              Name="StatusTextBlock"
              HorizontalAlignment="Center"
              FontSize="30"
              Text="{Binding LoadingMsg}"
            />
            <ProgressBar
              x:Name="StatusProgressBar"
              Height="10"
              Margin="10"
              IsIndeterminate="{Binding IsIndeterminate}"
              Maximum="100"
              Value="{Binding Progress}"
            />
          </StackPanel>
        </Grid>
      </Grid>
      <Grid Visibility="{Binding IsInList, Converter={StaticResource boolNotVisibeConverter}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="2*" />
          <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" MinHeight="40" Margin="0,2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button
            Name="BackButton"
            Grid.Column="0"
            Margin="5"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Click="BackButton_Click"
            ToolTip="{DynamicResource OnlineScriptBack}"
          >
            <Button.Content>
              <fa:FontAwesome
                Width="20"
                Height="20"
                FontSize="20"
                Foreground="{DynamicResource Brush.Foreground}"
                Icon="ArrowLeft"
              />
            </Button.Content>
          </Button>
          <TextBlock
            Grid.Column="1"
            Margin="4,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="22"
            Text="{Binding ScriptNow.Name}"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap"
            ToolTip="{Binding ScriptNow.Name}"
          />
          <Button
            Name="UrlButton"
            Grid.Column="2"
            Margin="5"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Click="UrlButton_Click"
            ToolTip="{DynamicResource OnlineScriptViewOnGitHub}"
          >
            <Button.Content>
              <fa:FontAwesome
                Width="20"
                Height="20"
                FontSize="20"
                Foreground="{DynamicResource Brush.Foreground}"
                Icon="Question"
              />
            </Button.Content>
          </Button>
        </Grid>
        <Grid Grid.Row="1" Margin="5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              FontSize="20"
              Text="{DynamicResource OnlineScriptAuthor}"
            />
            <TextBlock
              Grid.Column="1"
              FontSize="20"
              Text="{Binding ScriptNow.Author}"
              TextTrimming="CharacterEllipsis"
              ToolTip="{Binding ScriptNow.Author}"
            />
          </Grid>
          <StackPanel
            Grid.Column="1"
            Margin="8,0,0,0"
            Orientation="Horizontal"
          >
            <TextBlock FontSize="20" Text="{DynamicResource OnlineScriptVersion}" />
            <TextBlock FontSize="20" Text="{Binding ScriptNow.Version}" />
          </StackPanel>
        </Grid>
        <TextBlock
          Grid.Row="2"
          Margin="5"
          FontSize="20"
          Text="{Binding ScriptNow.Description}"
          TextWrapping="Wrap"
        />
        <TextBox
          Grid.Row="3"
          Margin="5"
          VerticalContentAlignment="Top"
          FontFamily="Consolas"
          FontSize="15"
          HorizontalScrollBarVisibility="Auto"
          IsReadOnly="True"
          Text="{Binding ScriptNow.Script}"
          TextWrapping="Wrap"
          VerticalScrollBarVisibility="Auto"
        />
        <Button
          Name="DownloadButton"
          Grid.Row="4"
          Height="40"
          Click="DownloadButton_Click"
          Content="{DynamicResource OnlineScriptDownload}"
          FontSize="20"
        />
      </Grid>
    </Grid>
  </Grid>
</Page>
