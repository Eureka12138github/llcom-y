<Page
  x:Class="llcom.Pages.OnlineScriptsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fa="http://schemas.fontawesome.io/icons/"
  xmlns:local="clr-namespace:llcom.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="OnlineScriptsPage"
  adonisExtensions:RippleExtension.FadeInDuration="0"
  adonisExtensions:RippleExtension.FadeOutDuration="0"
  d:DesignHeight="480"
  d:DesignWidth="400"
  Loaded="Page_Loaded"
  mc:Ignorable="d"
>
  
  <Grid>
    <Grid Visibility="{Binding IsLoding, Converter={StaticResource boolNotVisibeConverter}}">
      <Grid Visibility="{Binding IsInList, Converter={StaticResource boolVisibeConverter}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="40" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
          HorizontalAlignment="Center"
          FontSize="25"
          Text="{DynamicResource OnlineScriptTitle}"
        />
        <Button
          Name="RefreshButton"
          Margin="5"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Click="RefreshButton_Click"
        >
          <Button.Content>
            <fa:FontAwesome Width="20" Height="20" FontSize="20" Foreground="{DynamicResource Brush.Foreground}" Icon="undo" />
          </Button.Content>
        </Button>
        <Button
          Name="InfoButton"
          Margin="5"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Click="InfoButton_Click"
        >
          <Button.Content>
            <fa:FontAwesome Width="20" Height="20" FontSize="20" Foreground="{DynamicResource Brush.Foreground}" Icon="Info" />
          </Button.Content>
        </Button>

        <ScrollViewer Grid.Row="1" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="ScriptListItemsControl">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button
                  MinHeight="64"
                  Margin="0,2"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Center"
                  Background="{DynamicResource Brush.Surface}"
                  Click="Button_Click"
                  Tag="{Binding}"
                >
                  <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--  作者（自适应宽度） / 脚本名（占剩余宽度，加粗）  -->
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MaxWidth="120" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Text="{Binding Author}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Author}"
                      />
                      <TextBlock
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Name}"
                      />
                    </Grid>
                    <Border
                      Grid.Row="1"
                      Height="1"
                      Margin="0,6"
                      Background="{DynamicResource Brush.Border.Subtle}"
                    />
                    <!--  版本（左） / 简介（右）  -->
                    <Grid Grid.Row="2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource Brush.Foreground.Muted}"
                        Text="{Binding Version, StringFormat=v{0}}"
                      />
                      <TextBlock
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource Brush.Foreground.Subtle}"
                        Text="{Binding Description}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Description}"
                      />
                    </Grid>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
      <Grid Visibility="{Binding IsInList, Converter={StaticResource boolNotVisibeConverter}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="40" />
          <RowDefinition Height="auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="2*" />
          <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Button
          Name="BackButton"
          Margin="5"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Click="BackButton_Click"
        >
          <Button.Content>
            <fa:FontAwesome
              Width="20"
              Height="20"
              FontSize="20"
              Foreground="{DynamicResource Brush.Foreground}"
              Icon="ArrowLeft"
            />
          </Button.Content>
        </Button>
        <Button
          Name="UrlButton"
          Margin="5"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Click="UrlButton_Click"
        >
          <Button.Content>
            <fa:FontAwesome
              Width="20"
              Height="20"
              FontSize="20"
              Foreground="{DynamicResource Brush.Foreground}"
              Icon="Question"
            />
          </Button.Content>
        </Button>
        <TextBlock HorizontalAlignment="Center" FontSize="25" Text="{Binding ScriptNow.Name}" />
        <StackPanel Grid.Row="1" Margin="5" Orientation="Horizontal">
          <TextBlock FontSize="20" Text="{DynamicResource OnlineScriptAuthor}" />
          <TextBlock FontSize="20" Text="{Binding ScriptNow.Author}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="5" HorizontalAlignment="Right" Orientation="Horizontal">
          <TextBlock FontSize="20" Text="{DynamicResource OnlineScriptVersion}" />
          <TextBlock FontSize="20" Text="{Binding ScriptNow.Version}" />
        </StackPanel>
        <TextBlock
          Grid.Row="2"
          Margin="5"
          FontSize="20"
          Text="{Binding ScriptNow.Description}"
          TextWrapping="Wrap"
        />
        <TextBox
          Grid.Row="3"
          Margin="5"
          VerticalContentAlignment="Top"
          FontFamily="Consolas"
          FontSize="15"
          HorizontalScrollBarVisibility="Auto"
          IsReadOnly="True"
          Text="{Binding ScriptNow.Script}"
          TextWrapping="Wrap"
          VerticalScrollBarVisibility="Auto"
        />
        <Button
          Name="DownloadButton"
          Grid.Row="4"
          Height="40"
          Click="DownloadButton_Click"
          Content="{DynamicResource OnlineScriptDownload}"
          FontSize="20"
        />
      </Grid>
    </Grid>
    <Grid Visibility="{Binding IsLoding, Converter={StaticResource boolVisibeConverter}}">
      <StackPanel VerticalAlignment="Center">
        <TextBlock
          Name="StatusTextBlock"
          HorizontalAlignment="Center"
          FontSize="30"
          Text="{Binding LoadingMsg}"
        />
        <ProgressBar
          x:Name="StatusProgressBar"
          Height="10"
          Margin="10"
          IsIndeterminate="{Binding IsIndeterminate}"
          Maximum="100"
          Value="{Binding Progress}"
        />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
