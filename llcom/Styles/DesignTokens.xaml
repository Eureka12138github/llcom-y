<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=mscorlib"
>
  <!--
    LLCOM 设计令牌（Design Tokens）——UI 阶段 A。
    目的：把散落各页的硬编码颜色/间距集中到一处，便于统一与后续深色主题适配。
    说明：颜色暂取“浅色主题值”（与改造前一致，避免观感回归）；
         将来若要做深色主题，只需把这些 Brush 别名到 AdonisUI 的主题画笔。
  -->

  <!-- ============ 间距（4px 网格） ============ -->
  <sys:Double x:Key="Space.XS">4</sys:Double>
  <sys:Double x:Key="Space.S">8</sys:Double>
  <sys:Double x:Key="Space.M">12</sys:Double>
  <sys:Double x:Key="Space.L">16</sys:Double>
  <Thickness x:Key="Pad.XS">4</Thickness>
  <Thickness x:Key="Pad.S">8</Thickness>
  <Thickness x:Key="Pad.Control">4</Thickness>

  <!-- ============ 尺寸 ============ -->
  <sys:Double x:Key="Size.Control">32</sys:Double>
  <sys:Double x:Key="Size.Toolbar">40</sys:Double>
  <sys:Double x:Key="Size.IconButton">32</sys:Double>

  <!-- ============ 结构色 ============ -->
  <SolidColorBrush x:Key="Brush.Foreground" Color="#FF000000" />
  <SolidColorBrush x:Key="Brush.Foreground.Muted" Color="#FF696969" />
  <SolidColorBrush x:Key="Brush.Foreground.Subtle" Color="#FF8C8C8C" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.Surface.Subtle" Color="#FFF6F6F6" />
  <SolidColorBrush x:Key="Brush.Surface.Muted" Color="#FFD3D3D3" />
  <SolidColorBrush x:Key="Brush.Border" Color="#FFA9A9A9" />
  <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#FFD3D3D3" />

  <!-- ============ 日志/数据 ============ -->
  <SolidColorBrush x:Key="Brush.Log.Time" Color="#FF2F4F4F" />
  <SolidColorBrush x:Key="Brush.Data.Received" Color="#FF006400" />
  <SolidColorBrush x:Key="Brush.Data.Sent" Color="#FF8B0000" />

  <!-- ============ 状态 ============ -->
  <SolidColorBrush x:Key="Brush.State.Success" Color="#FF008000" />
  <SolidColorBrush x:Key="Brush.State.Error" Color="#FFFF0000" />
  <SolidColorBrush x:Key="Brush.State.Danger" Color="#FF8B0000" />
  <SolidColorBrush x:Key="Brush.State.Info" Color="#FF00BFFF" />

  <!-- ============ 强调色 ============ -->
  <SolidColorBrush x:Key="Brush.Accent.Blue" Color="#FF0000FF" />
  <SolidColorBrush x:Key="Brush.Accent.Brown" Color="#FFA52A2A" />
  <SolidColorBrush x:Key="Brush.Accent.Teal" Color="#FF008B8B" />

  <!-- ============ 图标 ============ -->
  <SolidColorBrush x:Key="Brush.Icon.Neutral" Color="#FF696969" />
  <SolidColorBrush x:Key="Brush.Icon.New" Color="#FF87CEFA" />
  <SolidColorBrush x:Key="Brush.Icon.Run" Color="#FF006400" />
  <SolidColorBrush x:Key="Brush.Icon.Folder" Color="#FFFFFF00" />
  <SolidColorBrush x:Key="Brush.Icon.NoteBack" Color="#FFFFFFE0" />
  <SolidColorBrush x:Key="Brush.Icon.Send" Color="#FFADD8E6" />
  <SolidColorBrush x:Key="Brush.Icon.Outline" Color="#FF000000" />
  <SolidColorBrush x:Key="Brush.Icon.Pause" Color="#FF228B22" />
  <SolidColorBrush x:Key="Brush.Icon.Doc" Color="#FF2F4F4F" />

  <!-- ============ 控件样式 ============ -->
  <!-- 纯图标按钮：统一 32×32、内容居中 -->
  <Style x:Key="IconButton" TargetType="{x:Type Button}">
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- 扁平图标按钮：常态无框无底色；悬停/按下用中性浅灰（贴近图标菜单的悬停观感，避免主题的蓝色强调色） -->
  <Style x:Key="FlatIconButton" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border
            x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True"
          >
            <ContentPresenter
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
            />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface.Muted}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ 工具页统一模板 ============ -->
  <!-- 工具页根容器：统一内边距 -->
  <Style x:Key="Tool.Content" TargetType="{x:Type Grid}">
    <Setter Property="Margin" Value="8" />
  </Style>
  <!-- 发送输入框：等宽、多行、可换行、自动滚动条 -->
  <Style x:Key="Tool.SendBox" TargetType="{x:Type TextBox}">
    <Setter Property="FontFamily" Value="Consolas" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="MinHeight" Value="60" />
  </Style>
  <!-- 段落小标题 -->
  <Style x:Key="Tool.SectionLabel" TargetType="{x:Type TextBlock}">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 状态栏文字：小字、次级色 -->
  <Style x:Key="Status.Text" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ============ 勾选框：勾选态用清晰的 ✓（全局覆盖主题默认外观） ============ -->
  <Style TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <StackPanel Background="Transparent" Orientation="Horizontal">
            <Border
              x:Name="Box"
              Width="15"
              Height="15"
              VerticalAlignment="Center"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="1"
              CornerRadius="2"
              SnapsToDevicePixels="True"
            >
              <Path
                x:Name="Check"
                Data="M 3,8 L 6,11 L 12,4"
                Stroke="{DynamicResource Brush.State.Success}"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="2"
                Stretch="None"
                Visibility="Collapsed"
              />
            </Border>
            <ContentPresenter
              Margin="6,0,0,0"
              VerticalAlignment="Center"
              RecognizesAccessKey="True"
            />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Foreground.Muted}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    “打开/关闭串口”按钮：自定义模板，悬停/按下用同色系加深（叠加半透明黑），
    避免主题默认悬停浅色背景覆盖绿色底、导致白色文字不可见。
  -->
  <Style x:Key="PortToggleButton" TargetType="{x:Type Button}">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Border
              x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="3"
              SnapsToDevicePixels="True"
            />
            <Border
              x:Name="Overlay"
              Background="#26000000"
              CornerRadius="3"
              IsHitTestVisible="False"
              Opacity="0"
            />
            <ContentPresenter
              Margin="{TemplateBinding Padding}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RecognizesAccessKey="True"
            />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Overlay" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Overlay" Property="Background" Value="#4D000000" />
              <Setter TargetName="Overlay" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- 串口已打开（端口下拉被禁用）时切到绿色底 + 白字 -->
      <DataTrigger Binding="{Binding IsPortComboEnabled}" Value="False">
        <Setter Property="Background" Value="{DynamicResource Brush.State.Success}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.State.Success}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>