<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <!--
    深色调色板（OpenCode 风格：中性深灰背景、低对比边框、柔和前景色）。
    合并顺序在 DesignTokens.xaml 之后，用来覆盖浅色 Brush.* 值。
    只放颜色，不放尺寸/样式。
  -->

  <!-- ============ 结构色 ============ -->
  <SolidColorBrush x:Key="Brush.Foreground" Color="#FFE6EDF3" />
  <SolidColorBrush x:Key="Brush.Foreground.Muted" Color="#FF8B949E" />
  <SolidColorBrush x:Key="Brush.Foreground.Subtle" Color="#FF6E7681" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FF0F1115" />
  <SolidColorBrush x:Key="Brush.Surface.Subtle" Color="#FF161B22" />
  <SolidColorBrush x:Key="Brush.Surface.Muted" Color="#FF21262D" />
  <SolidColorBrush x:Key="Brush.Border" Color="#FF30363D" />
  <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#FF21262D" />

  <!-- ============ 日志/数据 ============ -->
  <SolidColorBrush x:Key="Brush.Log.Time" Color="#FF8B949E" />
  <SolidColorBrush x:Key="Brush.Data.Received" Color="#FF7EE787" />
  <SolidColorBrush x:Key="Brush.Data.Sent" Color="#FFFF7B72" />

  <!-- ============ 状态 ============ -->
  <SolidColorBrush x:Key="Brush.State.Success" Color="#FF3FB950" />
  <SolidColorBrush x:Key="Brush.State.Error" Color="#FFF85149" />
  <SolidColorBrush x:Key="Brush.State.Danger" Color="#FFFF7B72" />
  <SolidColorBrush x:Key="Brush.State.Info" Color="#FF58A6FF" />

  <!-- ============ 强调色 ============ -->
  <SolidColorBrush x:Key="Brush.Accent.Blue" Color="#FF58A6FF" />
  <SolidColorBrush x:Key="Brush.Accent.Brown" Color="#FFD2A8FF" />
  <SolidColorBrush x:Key="Brush.Accent.Teal" Color="#FF56D4DD" />

  <!-- ============ 图标 ============ -->
  <SolidColorBrush x:Key="Brush.Icon.Neutral" Color="#FF8B949E" />
  <SolidColorBrush x:Key="Brush.Icon.New" Color="#FF79C0FF" />
  <SolidColorBrush x:Key="Brush.Icon.Run" Color="#FF3FB950" />
  <SolidColorBrush x:Key="Brush.Icon.Folder" Color="#FFD29922" />
  <SolidColorBrush x:Key="Brush.Icon.NoteBack" Color="#FFE3B341" />
  <SolidColorBrush x:Key="Brush.Icon.Send" Color="#FF56D4DD" />
  <SolidColorBrush x:Key="Brush.Icon.Outline" Color="#FFE6EDF3" />
  <SolidColorBrush x:Key="Brush.Icon.Pause" Color="#FF3FB950" />
  <SolidColorBrush x:Key="Brush.Icon.Doc" Color="#FFA5D6FF" />
</ResourceDictionary>
