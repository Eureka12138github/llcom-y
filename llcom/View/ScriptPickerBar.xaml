<UserControl
    x:Class="llcom.View.ScriptPickerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="http://schemas.fontawesome.io/icons/"
    x:Name="Root"
>
  <Grid>
  <Border
    Margin="0,0,0,6"
    Padding="6"
    Background="{DynamicResource Brush.Surface.Subtle}"
    BorderBrush="{DynamicResource Brush.Border.Subtle}"
    BorderThickness="1"
    CornerRadius="4"
  >
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!--  第一行：搜索 / 分类筛选 / 只看收藏  -->
      <Grid Grid.Row="0" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" MinWidth="30">
          <TextBox
            Name="SearchBox"
            Height="28"
            Padding="24,0,24,0"
            VerticalContentAlignment="Center"
            GotKeyboardFocus="SearchBox_GotKeyboardFocus"
            PreviewKeyDown="SearchBox_PreviewKeyDown"
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
            TextChanged="SearchBox_TextChanged"
            ToolTip="{DynamicResource ScriptSearchTip}"
          />
          <fa:FontAwesome
            Margin="7,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{DynamicResource Brush.Foreground.Subtle}"
            Icon="Search"
            IsHitTestVisible="False"
          />
          <TextBlock
            Margin="25,0,0,0"
            VerticalAlignment="Center"
            Foreground="{DynamicResource Brush.Foreground.Subtle}"
            IsHitTestVisible="False"
            Text="{DynamicResource ScriptSearchPlaceholder}"
          >
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button
            Name="ClearSearchButton"
            Width="20"
            Height="20"
            Margin="0,0,3,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Click="ClearSearch_Click"
            Content="×"
            FontSize="14"
            ToolTip="{DynamicResource ScriptSearchClear}"
            Visibility="Collapsed"
          >
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource FlatIconButton}">
                <Setter Property="Padding" Value="0" />
              </Style>
            </Button.Style>
          </Button>
        </Grid>

        <ComboBox
          Grid.Column="1"
          Width="96"
          Height="28"
          Margin="6,0,0,0"
          DisplayMemberPath="Label"
          ItemsSource="{Binding CategoryOptions}"
          SelectedItem="{Binding SelectedCategoryOption}"
          ToolTip="{DynamicResource ScriptCategoryTip}"
        />
        <CheckBox
          Grid.Column="2"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Content="{DynamicResource ScriptFavoritesOnly}"
          IsChecked="{Binding FavoritesOnly}"
        />
      </Grid>

      <!--  第二行：当前脚本 / 收藏 / 分类 / 更多（窄宽度自动换行）  -->
      <WrapPanel Grid.Row="1" Orientation="Horizontal">
        <ComboBox
          Name="ScriptCombo"
          Width="140"
          Height="28"
          Margin="0,0,6,4"
          ItemsSource="{Binding Files}"
          PreviewMouseRightButtonUp="ScriptCombo_PreviewMouseRightButtonUp"
          SelectedItem="{Binding VisibleSelectedFile}"
          ToolTip="{DynamicResource ScriptListTip}"
        />

        <Button
          Margin="0,0,4,4"
          Click="Favorite_Click"
        >
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
              <Setter Property="ToolTip" Value="{DynamicResource ScriptFavoriteAdd}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectedFavorite}" Value="True">
                  <Setter Property="ToolTip" Value="{DynamicResource ScriptFavoriteRemove}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Grid>
            <fa:FontAwesome
              FontSize="14"
              Foreground="{DynamicResource Brush.Icon.Neutral}"
              Icon="StarOutline"
            >
              <fa:FontAwesome.Style>
                <Style TargetType="fa:FontAwesome">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelectedFavorite}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </fa:FontAwesome.Style>
            </fa:FontAwesome>
            <fa:FontAwesome FontSize="14" Foreground="#FFDAA520" Icon="Star">
              <fa:FontAwesome.Style>
                <Style TargetType="fa:FontAwesome">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelectedFavorite}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </fa:FontAwesome.Style>
            </fa:FontAwesome>
          </Grid>
        </Button>

        <Button
          Height="28"
          Margin="0,0,4,4"
          Padding="7,0"
          Click="Category_Click"
          ToolTip="{DynamicResource ScriptCategoryChipTip}"
        >
          <StackPanel Orientation="Horizontal">
            <fa:FontAwesome
              Margin="0,0,4,0"
              VerticalAlignment="Center"
              FontSize="11"
              Foreground="{DynamicResource Brush.Icon.Neutral}"
              Icon="Tag"
            />
            <TextBlock
              MaxWidth="64"
              VerticalAlignment="Center"
              Text="{Binding SelectedCategoryDisplay}"
              TextTrimming="CharacterEllipsis"
            />
          </StackPanel>
        </Button>

        <Button
          Name="MoreButton"
          Margin="0,0,0,4"
          Click="MoreButton_Click"
          Style="{StaticResource IconButton}"
          ToolTip="{DynamicResource ScriptMore}"
        >
          <fa:FontAwesome FontSize="14" Icon="EllipsisH" />
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem
                Click="Favorite_Click"
                Header="{DynamicResource ScriptToggleFavorite}"
              />
              <MenuItem Click="Pin_Click" Header="{DynamicResource ScriptPin}" />
              <MenuItem Click="Unpin_Click" Header="{DynamicResource ScriptUnpin}" />
              <Separator />
              <MenuItem Click="Category_Click" Header="{DynamicResource ScriptSetCategory}" />
              <MenuItem
                Click="Description_Click"
                Header="{DynamicResource ScriptSetDescription}"
              />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </WrapPanel>

      <!--  第三行：页面操作按钮（约束在可用宽度内，自动换行）  -->
      <ContentPresenter
        Grid.Row="2"
        Margin="0,2,0,0"
        VerticalAlignment="Center"
        Content="{Binding ActionsContent, ElementName=Root}"
      />
    </Grid>
  </Border>

  <!--  搜索结果：输入即显示，不再依赖 ComboBox 下拉  -->
  <Popup
    Name="ResultsPopup"
    AllowsTransparency="True"
    Placement="Bottom"
    PlacementTarget="{Binding ElementName=SearchBox}"
    PopupAnimation="Fade"
    StaysOpen="False"
    VerticalOffset="4"
  >
    <Border
      Width="{Binding ActualWidth, ElementName=SearchBox}"
      MinWidth="260"
      MaxHeight="280"
      Background="{DynamicResource Brush.Surface}"
      BorderBrush="{DynamicResource Brush.Border}"
      BorderThickness="1"
      SnapsToDevicePixels="True"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
          Grid.Row="0"
          Margin="10,8,10,4"
          FontWeight="Bold"
          Text="{DynamicResource ScriptSearchResults}"
        />
        <ListBox
          Name="ResultsList"
          Grid.Row="1"
          MaxHeight="220"
          Background="Transparent"
          BorderThickness="0"
          ItemsSource="{Binding ScriptItems}"
          PreviewKeyDown="ResultsList_PreviewKeyDown"
          PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
        >
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="8,5" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <fa:FontAwesome
                  Grid.Column="0"
                  Margin="0,0,6,0"
                  VerticalAlignment="Center"
                  FontSize="11"
                  Foreground="#FFDAA520"
                  Icon="Star"
                >
                  <fa:FontAwesome.Style>
                    <Style TargetType="fa:FontAwesome">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Favorite}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </fa:FontAwesome.Style>
                </fa:FontAwesome>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource Brush.Foreground.Muted}"
                    Text="{Binding Description}"
                    TextTrimming="CharacterEllipsis"
                  >
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Description}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <Border
                  Grid.Column="2"
                  Margin="6,0,0,0"
                  Padding="5,1"
                  VerticalAlignment="Center"
                  Background="{DynamicResource Brush.Surface.Subtle}"
                  BorderBrush="{DynamicResource Brush.Border.Subtle}"
                  BorderThickness="1"
                  CornerRadius="3"
                >
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Category}" Value="">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock
                    FontSize="10"
                    Foreground="{DynamicResource Brush.Foreground.Muted}"
                    Text="{Binding Category}"
                  />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock
          Grid.Row="1"
          Margin="10,10,10,12"
          Foreground="{DynamicResource Brush.Foreground.Muted}"
          Text="{DynamicResource ScriptNoMatch}"
        >
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ScriptItems.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>
  </Popup>
  </Grid>
</UserControl>
