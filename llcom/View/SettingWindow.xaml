<Window
  x:Class="llcom.SettingWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fa="http://schemas.fontawesome.io/icons/"
  xmlns:local="clr-namespace:llcom"
  xmlns:local_page="clr-namespace:llcom.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="{DynamicResource SettingTitle}"
  Width="450"
  Height="490"
  adonisExtensions:RippleExtension.FadeInDuration="0"
  adonisExtensions:RippleExtension.FadeOutDuration="0"
  Loaded="Window_Loaded"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d"
>
  <Window.Style>
    <Style BasedOn="{StaticResource {x:Type Window}}" TargetType="Window" />
  </Window.Style>
  
  <Grid>
    <TabControl>
      <TabItem Header="{DynamicResource SettingBasic}">
        <ScrollViewer>
          <StackPanel Margin="10,0,0,0">
            <Button
              Name="OpenLogButton"
              Margin="8"
              Click="OpenLogButton_Click"
              Content="{DynamicResource SettingOpenLogFolder}"
            />
            <CheckBox
              Margin="8"
              Content="{DynamicResource SettingShowSend}"
              IsChecked="{Binding showSend}"
            />
            <CheckBox
              Margin="8"
              Content="{DynamicResource RecvHexView}"
              IsChecked="{Binding recvShowHex}"
            />
            <StackPanel Margin="8" Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Text="{DynamicResource SettingLogFontSize}" />
              <Slider
                Width="150"
                VerticalAlignment="Center"
                IsSnapToTickEnabled="True"
                Maximum="40"
                Minimum="10"
                TickFrequency="1"
                Value="{Binding logFontSize}"
              />
              <TextBlock
                MinWidth="20"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding logFontSize}"
              />
            </StackPanel>
            <CheckBox
              Margin="8"
              Content="{DynamicResource SettingKeepTop}"
              IsChecked="{Binding topmost}"
            />
            <StackPanel Margin="8" Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Text="{DynamicResource SettingUartTimeout}" />
              <TextBox
                MinWidth="50"
                Text="{Binding timeout, UpdateSourceTrigger=PropertyChanged}"
              />
              <TextBlock
                Margin="3,0"
                VerticalAlignment="Center"
                Text="{DynamicResource SettingMs}"
              />
            </StackPanel>
            <CheckBox
              Margin="8"
              Content="{DynamicResource SettingSplitByEmpty}"
              IsChecked="{Binding bitDelay}"
            />
            <CheckBox
              Margin="8"
              Content="{DynamicResource SettingTerminal}"
              IsChecked="{Binding terminal}"
            />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource SettingSendLuaScript}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
          </Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,5" Orientation="Horizontal">
            <ComboBox
              Name="luaFileList"
              Width="250"
              ItemsSource="{Binding Files}"
              SelectedItem="{Binding SelectedFile}"
            />
            <Button
              Name="newScriptButton"
              Style="{StaticResource IconButton}"
              Margin="4,0,0,0"
              Click="NewScriptButton_Click"
              ToolTip="{DynamicResource LuaNewScript}"
            >
              <Grid>
                <fa:FontAwesome Foreground="{DynamicResource Brush.Icon.New}" Icon="File" />
                <fa:FontAwesome Icon="FileCodeOutline" />
              </Grid>
            </Button>
            <Button
              Name="testScriptButton"
              Style="{StaticResource IconButton}"
              Margin="4,0,0,0"
              Click="TestScriptButton_Click"
              ToolTip="{DynamicResource SettingLuaTestScript}"
            >
              <fa:FontAwesome Foreground="{DynamicResource Brush.Icon.Run}" Icon="Play" />
            </Button>
            <Button
              Name="openScriptFolderButton"
              Style="{StaticResource IconButton}"
              Margin="4,0,0,0"
              Click="OpenScriptFolderButton_Click"
              ToolTip="{DynamicResource LuaOpenFolder}"
            >
              <Grid>
                <fa:FontAwesome Foreground="{DynamicResource Brush.Icon.Folder}" Icon="FolderOpen" />
                <fa:FontAwesome Icon="FolderOutlinepenOutline" />
              </Grid>
            </Button>
            <Button
              Name="apiDocumentButton"
              Style="{StaticResource IconButton}"
              Margin="4,0,0,0"
              Click="ApiDocumentButton_Click"
              ToolTip="{DynamicResource LuaApiReference}"
            >
              <fa:FontAwesome Foreground="{DynamicResource Brush.Icon.Doc}" Icon="Book" />
            </Button>
          </WrapPanel>
          <WrapPanel Name="newLuaFileWrapPanel" Grid.Row="1" Margin="3" Visibility="Collapsed">
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource LuaFileName}" />
            <TextBox Name="newLuaFileNameTextBox" Width="90" Text="new script" />
            <Button
              Name="newLuaFilebutton"
              Style="{StaticResource IconButton}"
              Margin="4,0,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Click="NewLuaFilebutton_Click"
              ToolTip="{DynamicResource LuaConfirmCreate}"
            >
              <fa:FontAwesome Foreground="{DynamicResource Brush.State.Success}" Icon="Check" />
            </Button>
            <Button
              Name="newLuaFileCancelbutton"
              Style="{StaticResource IconButton}"
              Margin="4,0,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Click="NewLuaFileCancelbutton_Click"
              ToolTip="{DynamicResource LuaCancel}"
            >
              <fa:FontAwesome Foreground="{DynamicResource Brush.State.Error}" Icon="Ban" />
            </Button>
          </WrapPanel>
          <WrapPanel Name="luaTestWrapPanel" Grid.Row="1" Margin="3" Visibility="Collapsed">
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource SettingLuaTestInput}" />
            <TextBox Name="luaTestTextBox" Margin="4,0,0,0" Width="155" Text="uart data" />
            <CheckBox
              Name="luaTestHexCheck"
              Margin="4,0,0,0"
              Content="HEX"
              IsChecked="{Binding luaTestHex}"
            />
            <Button
              Name="luaTestbutton"
              Style="{StaticResource IconButton}"
              Margin="4,0,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Click="LuaTestbutton_Click"
              ToolTip="{DynamicResource SettingLuaTestButton}"
            >
              <Grid>
                <fa:FontAwesome Foreground="{DynamicResource Brush.Icon.Send}" Icon="PaperPlane" />
                <fa:FontAwesome Foreground="{DynamicResource Brush.Foreground}" Icon="PaperPlaneOutline" />
              </Grid>
            </Button>
            <Button
              Name="luaTestCancelbutton"
              Style="{StaticResource IconButton}"
              Margin="4,0,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Click="LuaTestCancelbutton_Click"
              ToolTip="{DynamicResource LuaCancel}"
            >
              <fa:FontAwesome Foreground="{DynamicResource Brush.State.Error}" Icon="Ban" />
            </Button>
          </WrapPanel>
          <avalonEdit:TextEditor
            xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
            Name="textEditor"
            Grid.Row="2"
            FontFamily="Consolas"
            FontSize="10pt"
            LostFocus="TextEditor_LostFocus"
            ShowLineNumbers="True"
          />
          <WrapPanel Grid.Row="3" Margin="8">
            <TextBlock Text="{DynamicResource SettingLuaText1}" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource SettingLuaText2}" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource SettingLuaText3}" TextWrapping="Wrap" />
          </WrapPanel>
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource SettingRecvLuaScript}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
          </Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,5" Orientation="Horizontal">
            <ComboBox
              Name="luaFileListRev"
              Width="250"
              ItemsSource="{Binding Files}"
              SelectedItem="{Binding SelectedFile}"
            />
            <Button
              Name="newScriptButtonRev"
              Style="{StaticResource IconButton}"
              Margin="4,0,0,0"
              Click="newScriptButtonRev_Click"
              ToolTip="{DynamicResource LuaNewScript}"
            >
              <Grid>
                <fa:FontAwesome Foreground="{DynamicResource Brush.Icon.New}" Icon="File" />
                <fa:FontAwesome Icon="FileCodeOutline" />
              </Grid>
            </Button>
            <Button
              Name="testScriptButtonRev"
              Style="{StaticResource IconButton}"
              Margin="4,0,0,0"
              Click="testScriptButtonRev_Click"
              ToolTip="{DynamicResource SettingLuaTestScript}"
            >
              <fa:FontAwesome Foreground="{DynamicResource Brush.Icon.Run}" Icon="Play" />
            </Button>
            <Button
              Name="openScriptFolderButtonRev"
              Style="{StaticResource IconButton}"
              Margin="4,0,0,0"
              Click="openScriptFolderButtonRev_Click"
              ToolTip="{DynamicResource LuaOpenFolder}"
            >
              <Grid>
                <fa:FontAwesome Foreground="{DynamicResource Brush.Icon.Folder}" Icon="FolderOpen" />
                <fa:FontAwesome Icon="FolderOutlinepenOutline" />
              </Grid>
            </Button>
            <Button
              Name="apiDocumentButtonRev"
              Style="{StaticResource IconButton}"
              Margin="4,0,0,0"
              Click="ApiDocumentButton_Click"
              ToolTip="{DynamicResource LuaApiReference}"
            >
              <fa:FontAwesome Foreground="{DynamicResource Brush.Icon.Doc}" Icon="Book" />
            </Button>
          </WrapPanel>
          <WrapPanel Name="newLuaFileWrapPanelRev" Grid.Row="1" Margin="3" Visibility="Collapsed">
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource LuaFileName}" />
            <TextBox Name="newLuaFileNameTextBoxRev" Width="90" Text="new script" />
            <Button
              Name="newLuaFilebuttonRev"
              Style="{StaticResource IconButton}"
              Margin="4,0,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Click="newLuaFilebuttonRev_Click"
              ToolTip="{DynamicResource LuaConfirmCreate}"
            >
              <fa:FontAwesome Foreground="{DynamicResource Brush.State.Success}" Icon="Check" />
            </Button>
            <Button
              Name="newLuaFileCancelbuttonRev"
              Style="{StaticResource IconButton}"
              Margin="4,0,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Click="newLuaFileCancelbuttonRev_Click"
              ToolTip="{DynamicResource LuaCancel}"
            >
              <fa:FontAwesome Foreground="{DynamicResource Brush.State.Error}" Icon="Ban" />
            </Button>
          </WrapPanel>
          <Grid
            Grid.Row="1"
            Visibility="{Binding ElementName=luaTestWrapPanelRev, Path=Visibility}"
          >
            <Grid.RowDefinitions>
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <WrapPanel Name="luaTestWrapPanelRev" Grid.Row="0" Margin="3" Visibility="Collapsed">
              <TextBlock VerticalAlignment="Center" Text="{DynamicResource SettingLuaTestInput}" />
              <TextBox Name="luaTestTextBoxRev" Margin="4,0,0,0" Width="155" Text="uart data" />
              <CheckBox
                Name="luaTestHexCheckRev"
                Margin="4,0,0,0"
                Content="HEX"
                IsChecked="{Binding luaTestHexRev}"
              />
              <Button
                Name="luaTestbuttonRev"
                Style="{StaticResource IconButton}"
                Margin="4,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="luaTestbuttonRev_Click"
                ToolTip="{DynamicResource SettingLuaTestButton}"
              >
                <Grid>
                  <fa:FontAwesome Foreground="{DynamicResource Brush.Icon.Send}" Icon="PaperPlane" />
                  <fa:FontAwesome Foreground="{DynamicResource Brush.Foreground}" Icon="PaperPlaneOutline" />
                </Grid>
              </Button>
              <Button
                Name="luaTestCancelbuttonRev"
                Style="{StaticResource IconButton}"
                Margin="4,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="luaTestCancelbuttonRev_Click"
                ToolTip="{DynamicResource LuaCancel}"
              >
                <fa:FontAwesome Foreground="{DynamicResource Brush.State.Error}" Icon="Ban" />
              </Button>
            </WrapPanel>
          </Grid>
          <avalonEdit:TextEditor
            xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
            Name="textEditorRev"
            Grid.Row="2"
            FontFamily="Consolas"
            FontSize="10pt"
            LostFocus="textEditorRev_LostFocus"
            ShowLineNumbers="True"
          />
          <WrapPanel Grid.Row="3" Margin="8">
            <TextBlock Text="{DynamicResource SettingLuaText1Recv}" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource SettingLuaText2Recv}" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource SettingLuaText3}" TextWrapping="Wrap" />
          </WrapPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
