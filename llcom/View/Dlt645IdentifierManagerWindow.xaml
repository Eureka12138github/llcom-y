<Window
  x:Class="llcom.View.Dlt645IdentifierManagerWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="{DynamicResource Dlt645ManageDiTitle}"
  Width="780"
  Height="480"
  MinWidth="600"
  MinHeight="360"
  Background="{DynamicResource Brush.Surface}"
  Foreground="{DynamicResource Brush.Foreground}"
  adonisExtensions:RippleExtension.FadeInDuration="0"
  adonisExtensions:RippleExtension.FadeOutDuration="0"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  mc:Ignorable="d"
>
  <Grid Margin="8" TextElement.Foreground="{DynamicResource Brush.Foreground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--
      列宽统一用固定像素（不用星号）：DataGrid 的空间不足时会把固定列压扁到视口内，
      星号列永远不会触发横向滚动条。固定像素宽度总和超过视口时才会出现横条，
      可左右拖动查看完整备注；「备注」列的实际宽度由代码按窗口宽度动态调整。
    -->
    <DataGrid
      Name="IdentifierGrid"
      AutoGenerateColumns="False"
      CanUserAddRows="False"
      CanUserDeleteRows="False"
      GridLinesVisibility="Horizontal"
      HeadersVisibility="Column"
      ScrollViewer.HorizontalScrollBarVisibility="Auto"
      SelectionMode="Extended"
      SelectionUnit="FullRow"
      SizeChanged="IdentifierGrid_SizeChanged"
    >
      <DataGrid.Columns>
        <DataGridTextColumn
          Width="220"
          Binding="{Binding Name}"
          Header="{DynamicResource Dlt645DiName}"
        />
        <DataGridTextColumn
          Width="120"
          Binding="{Binding Code}"
          Header="{DynamicResource Dlt645DiCode}"
        />
        <DataGridTextColumn
          Width="110"
          Binding="{Binding Category}"
          Header="{DynamicResource Dlt645DiCategory}"
        />
        <DataGridTextColumn
          Width="80"
          Binding="{Binding Unit}"
          Header="{DynamicResource Dlt645DiUnit}"
        />
        <DataGridTextColumn
          Width="70"
          Binding="{Binding Decimals}"
          Header="{DynamicResource Dlt645DiDecimals}"
        />
        <!-- 备注列：窗口宽时铺满剩余空间，窄时保持最小宽度并出现横向滚动条 -->
        <DataGridTextColumn
          x:Name="NoteColumn"
          Width="420"
          Binding="{Binding Note}"
          Header="{DynamicResource Dlt645DiNote}"
        >
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>

    <WrapPanel Grid.Row="1" Margin="0,8,0,0" Orientation="Horizontal">
      <Button
        MinWidth="72"
        Height="30"
        Click="AddButton_Click"
        Content="{DynamicResource Dlt645DiAdd}"
      />
      <Button
        MinWidth="88"
        Height="30"
        Margin="6,0,0,0"
        Click="DeleteButton_Click"
        Content="{DynamicResource Dlt645DiDelete}"
      />
      <Button
        MinWidth="88"
        Height="30"
        Margin="6,0,0,0"
        Click="RestoreButton_Click"
        Content="{DynamicResource Dlt645DiRestoreDefaults}"
      />
      <Button
        MinWidth="72"
        Height="30"
        Margin="18,0,0,0"
        Click="ImportButton_Click"
        Content="{DynamicResource Dlt645ImportDi}"
      />
      <Button
        MinWidth="72"
        Height="30"
        Margin="6,0,0,0"
        Click="ExportButton_Click"
        Content="{DynamicResource Dlt645ExportDi}"
      />
      <Button
        MinWidth="72"
        Height="30"
        Margin="18,0,0,0"
        Click="SaveButton_Click"
        Content="{DynamicResource Dlt645DiSave}"
      />
      <Button
        MinWidth="72"
        Height="30"
        Margin="6,0,0,0"
        Click="CancelButton_Click"
        Content="{DynamicResource Dlt645DiCancel}"
      />
    </WrapPanel>
  </Grid>
</Window>
