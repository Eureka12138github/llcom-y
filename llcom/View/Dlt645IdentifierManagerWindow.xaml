<Window
  x:Class="llcom.View.Dlt645IdentifierManagerWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="{DynamicResource Dlt645ManageDiTitle}"
  Width="780"
  Height="480"
  MinWidth="600"
  MinHeight="360"
  Background="{DynamicResource Brush.Surface}"
  Foreground="{DynamicResource Brush.Foreground}"
  adonisExtensions:RippleExtension.FadeInDuration="0"
  adonisExtensions:RippleExtension.FadeOutDuration="0"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  mc:Ignorable="d"
>
  <Grid Margin="8" TextElement.Foreground="{DynamicResource Brush.Foreground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DataGrid
      Name="IdentifierGrid"
      AutoGenerateColumns="False"
      CanUserAddRows="False"
      CanUserDeleteRows="False"
      GridLinesVisibility="Horizontal"
      HeadersVisibility="Column"
      SelectionMode="Extended"
      SelectionUnit="FullRow"
    >
      <DataGrid.Columns>
        <DataGridTextColumn
          Width="2*"
          Binding="{Binding Name}"
          Header="{DynamicResource Dlt645DiName}"
        />
        <DataGridTextColumn
          Width="120"
          Binding="{Binding Code}"
          Header="{DynamicResource Dlt645DiCode}"
        />
        <DataGridTextColumn
          Width="110"
          Binding="{Binding Category}"
          Header="{DynamicResource Dlt645DiCategory}"
        />
        <DataGridTextColumn
          Width="80"
          Binding="{Binding Unit}"
          Header="{DynamicResource Dlt645DiUnit}"
        />
        <DataGridTextColumn
          Width="70"
          Binding="{Binding Decimals}"
          Header="{DynamicResource Dlt645DiDecimals}"
        />
        <DataGridTextColumn
          Width="*"
          Binding="{Binding Note}"
          Header="{DynamicResource Dlt645DiNote}"
        />
      </DataGrid.Columns>
    </DataGrid>

    <WrapPanel Grid.Row="1" Margin="0,8,0,0" Orientation="Horizontal">
      <Button
        MinWidth="72"
        Height="30"
        Click="AddButton_Click"
        Content="{DynamicResource Dlt645DiAdd}"
      />
      <Button
        MinWidth="88"
        Height="30"
        Margin="6,0,0,0"
        Click="DeleteButton_Click"
        Content="{DynamicResource Dlt645DiDelete}"
      />
      <Button
        MinWidth="88"
        Height="30"
        Margin="6,0,0,0"
        Click="RestoreButton_Click"
        Content="{DynamicResource Dlt645DiRestoreDefaults}"
      />
      <Button
        MinWidth="72"
        Height="30"
        Margin="18,0,0,0"
        Click="ImportButton_Click"
        Content="{DynamicResource Dlt645ImportDi}"
      />
      <Button
        MinWidth="72"
        Height="30"
        Margin="6,0,0,0"
        Click="ExportButton_Click"
        Content="{DynamicResource Dlt645ExportDi}"
      />
      <Button
        MinWidth="72"
        Height="30"
        Margin="18,0,0,0"
        Click="SaveButton_Click"
        Content="{DynamicResource Dlt645DiSave}"
      />
      <Button
        MinWidth="72"
        Height="30"
        Margin="6,0,0,0"
        Click="CancelButton_Click"
        Content="{DynamicResource Dlt645DiCancel}"
      />
    </WrapPanel>
  </Grid>
</Window>
