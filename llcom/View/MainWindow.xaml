<Window
  x:Class="llcom.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fa="http://schemas.fontawesome.io/icons/"
  xmlns:local="clr-namespace:llcom"
  xmlns:local_page="clr-namespace:llcom.Pages"
  xmlns:local_tool="clr-namespace:llcom.Tools"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="{DynamicResource AppTitle}"
  Width="900"
  Height="500"
  adonisExtensions:RippleExtension.FadeInDuration="0"
  adonisExtensions:RippleExtension.FadeOutDuration="0"
  Activated="Window_Activated"
  Deactivated="Window_Deactivated"
  Loaded="Window_Loaded"
  mc:Ignorable="d"
>
  <Window.Style>
    <Style BasedOn="{StaticResource {x:Type Window}}" TargetType="Window" />
  </Window.Style>
  
  <Window.InputBindings>
    <KeyBinding Key="Return" Command="{Binding SendCommand}" Gesture="Ctrl+Return" />
  </Window.InputBindings>
  <Grid Name="MainGrid" IsEnabled="False">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="120" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="40" MinHeight="40" MaxHeight="240" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="12*" MinWidth="240" />
      <ColumnDefinition Width="auto" />
      <ColumnDefinition Width="8*" MinWidth="240" />
    </Grid.ColumnDefinitions>

    <!--  收发数据显示  -->
    <Frame
      Name="dataShowFrame"
      Grid.Row="0"
      Margin="8,6,0,0"
      Background="Transparent"
      BorderBrush="#00000000"
      BorderThickness="0.5"
      GotFocus="uartDataFlowDocument_GotFocus"
      LostFocus="uartDataFlowDocument_LostFocus"
      NavigationUIVisibility="Hidden"
      PreviewKeyDown="uartDataFlowDocument_PreviewKeyDown"
      PreviewTextInput="uartDataFlowDocument_PreviewTextInput"
    />

    <!--  日志底栏右端：使用说明 / 更多设置 / 语言（同一行右对齐；平时隐藏，鼠标悬浮该区域时淡入）  -->
    <Grid
      Name="LogCornerZone"
      Grid.Row="0"
      Height="32"
      Margin="0,0,10,3"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom"
      Background="Transparent"
      MouseEnter="LogCornerZone_MouseEnter"
      MouseLeave="LogCornerZone_MouseLeave"
    >
      <StackPanel
        Name="LogCornerTools"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Opacity="0"
        IsHitTestVisible="False"
        Orientation="Horizontal"
      >
        <!--  帮助：扁平纯图标（常态无框；悬停中性浅灰）  -->
        <Button
          Name="HelpButton"
          Margin="4,0,0,0"
          Style="{StaticResource FlatIconButton}"
          AutomationProperties.Name="{DynamicResource Help}"
          Click="HelpButton_Click"
          ToolTip="{DynamicResource Help}"
        >
          <fa:FontAwesome Foreground="{DynamicResource Brush.Accent.Teal}" Icon="Question" />
        </Button>
        <!--  直接打开“更多设置”  -->
        <Button
          Name="MoreSettingButton"
          Margin="4,0,0,0"
          Style="{StaticResource FlatIconButton}"
          AutomationProperties.Name="{DynamicResource MoreSettings}"
          Click="MoreSettingButton_Click"
          ToolTip="{DynamicResource MoreSettings}"
        >
          <fa:FontAwesome Foreground="{DynamicResource Brush.Foreground}" Icon="Bars" />
        </Button>
        <Menu Margin="4,0,0,0" VerticalAlignment="Center">
          <MenuItem ToolTip="{DynamicResource ChangeLanguage}">
            <MenuItem.Header>
              <fa:FontAwesome Foreground="{DynamicResource Brush.Accent.Blue}" Icon="Globe" />
            </MenuItem.Header>
            <MenuItem Click="MenuItem_Click" Header="简体中文" Tag="zh-CN" />
            <MenuItem Click="MenuItem_Click" Header="English" Tag="en-US" />
          </MenuItem>
        </Menu>
      </StackPanel>
    </Grid>

    <!--  日志/发送区之间的可拖拽分隔条（上下调整发送区高度）  -->
    <GridSplitter
      Grid.Row="1"
      Grid.ColumnSpan="3"
      Height="5"
      HorizontalAlignment="Stretch"
      Cursor="SizeNS"
      ResizeBehavior="PreviousAndNext"
      ResizeDirection="Rows"
    >
      <GridSplitter.Style>
        <Style TargetType="GridSplitter">
          <Setter Property="Background" Value="Transparent" />
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource Brush.Surface.Muted}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </GridSplitter.Style>
    </GridSplitter>

    <!--  发送数据区（跨全宽；高度可拖拽）  -->
    <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="8,2,8,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox
        Name="toSendDataTextBox"
        Margin="0,0,8,0"
        VerticalContentAlignment="Top"
        AcceptsReturn="True"
        FontFamily="Consolas"
        FontSize="{Binding Setting.logFontSize}"
        PreviewKeyDown="ToSendDataTextBox_PreviewKeyDown"
        Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
        TextWrapping="Wrap"
        VerticalScrollBarVisibility="Auto"
      />
      <!--  清除发送框内容  -->
      <Button
        Name="clearSendBoxButton"
        Grid.Column="1"
        VerticalAlignment="Center"
        Style="{StaticResource IconButton}"
        AutomationProperties.Name="{DynamicResource ClearSendBox}"
        Click="ClearSendBoxButton_Click"
        ToolTip="{DynamicResource ClearSendBox}"
      >
        <fa:FontAwesome
          FontSize="16"
          Foreground="{DynamicResource Brush.Foreground}"
          Icon="Eraser"
        />
      </Button>
      <!--  发送记录：点历史项填回发送框；底部可调记录上限  -->
      <Button
        Name="sendHistoryButton"
        Grid.Column="2"
        Margin="2,0,0,0"
        VerticalAlignment="Center"
        Style="{StaticResource IconButton}"
        AutomationProperties.Name="{DynamicResource SendHistory}"
        Click="SendHistoryButton_Click"
        ToolTip="{DynamicResource SendHistory}"
      >
        <fa:FontAwesome
          FontSize="16"
          Foreground="{DynamicResource Brush.Foreground}"
          Icon="History"
        />
      </Button>
      <!--  追加换行  -->
      <ComboBox
        Name="appendNewlineComboBox"
        Grid.Column="3"
        Width="86"
        Height="32"
        Margin="8,0,0,0"
        VerticalAlignment="Center"
        SelectedIndex="{Binding Setting.appendNewline}"
        ToolTip="{DynamicResource AppendNewlineTip}"
      >
        <ComboBoxItem Content="{DynamicResource AppendNone}" />
        <ComboBoxItem Content="\n" />
        <ComboBoxItem Content="\r" />
        <ComboBoxItem Content="\n\r" />
        <ComboBoxItem Content="\r\n" />
      </ComboBox>
      <StackPanel
        Grid.Column="4"
        Margin="8,0,0,0"
        VerticalAlignment="Center"
        Orientation="Horizontal"
      >
        <!--  开/关串口（与「串口设置」页底部按钮同一命令；绿=未打开、红=已打开）  -->
        <Button
          Name="sendAreaPortButton"
          Width="32"
          Height="32"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          AutomationProperties.Name="{DynamicResource OpenPort_port}"
          Command="{Binding OpenClosePortCommand}"
          Style="{StaticResource IconButton}"
        >
          <Grid>
            <fa:FontAwesome
              FontSize="14"
              Foreground="{DynamicResource Brush.State.Success}"
              Icon="Plug"
              Visibility="{Binding IsPortOpen, Converter={StaticResource boolNotVisibeConverter}}"
            />
            <fa:FontAwesome
              FontSize="14"
              Foreground="{DynamicResource Brush.State.Danger}"
              Icon="Plug"
              Visibility="{Binding IsPortOpen, Converter={StaticResource boolVisibeConverter}}"
            />
          </Grid>
          <Button.ToolTip>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding OpenCloseButtonText}" />
              <TextBlock Text="{DynamicResource OpenPort_port}" />
            </StackPanel>
          </Button.ToolTip>
        </Button>
        <Button
          Name="sendDataButton"
          Width="80"
          Height="32"
          Command="{Binding SendCommand}"
          Content="{DynamicResource SendDataButton}"
          ToolTip="{DynamicResource SendDataButtonTip}"
        />
        <!--  发送选项：连续发送 / 发送后延时 / 重复次数 / Enter 行为  -->
        <Button
          Name="sendOptionButton"
          Width="24"
          Height="32"
          Margin="2,0,0,0"
          VerticalAlignment="Center"
          AutomationProperties.Name="{DynamicResource SendOption}"
          Click="SendOptionButton_Click"
          ToolTip="{DynamicResource SendOptionTip}"
        >
          <fa:FontAwesome FontSize="9" Icon="CaretDown" />
          <Button.ContextMenu>
            <ContextMenu Name="sendOptionMenu" Opened="SendOptionMenu_Opened">
              <MenuItem
                Name="continuousSendMenuItem"
                Click="ContinuousSendMenuItem_Click"
                Header="{DynamicResource ContinuousSend}"
                IsCheckable="True"
                StaysOpenOnClick="True"
              />
              <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <Button
                      Width="24"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      Click="ContinuousDelayMinus_Click"
                      Content="－"
                      Cursor="Hand"
                    />
                    <TextBlock
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Text="{DynamicResource ContinuousDelayText}"
                    />
                    <TextBox
                      Name="continuousDelayBox"
                      Width="70"
                      VerticalAlignment="Center"
                      ToolTip="{DynamicResource ContinuousDelayTip}"
                      LostFocus="ContinuousDelayBox_LostFocus"
                    />
                    <Button
                      Width="24"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      Click="ContinuousDelayPlus_Click"
                      Content="＋"
                      Cursor="Hand"
                    />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem StaysOpenOnClick="True" ToolTip="{DynamicResource ContinuousRepeatTip}">
                <MenuItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <Button
                      Width="24"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      Click="ContinuousRepeatMinus_Click"
                      Content="－"
                      Cursor="Hand"
                    />
                    <TextBlock
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      Text="{DynamicResource ContinuousRepeatText}"
                    />
                    <TextBox
                      Name="continuousRepeatBox"
                      Width="70"
                      VerticalAlignment="Center"
                      ToolTip="{DynamicResource ContinuousRepeatTip}"
                      LostFocus="ContinuousRepeatBox_LostFocus"
                    />
                    <Button
                      Width="24"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      Click="ContinuousRepeatPlus_Click"
                      Content="＋"
                      Cursor="Hand"
                    />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <Separator />
              <MenuItem
                Name="sendByEnterMenuItem"
                Click="SendByEnterMenuItem_Click"
                Header="{DynamicResource SendByEnter}"
                IsCheckable="True"
                StaysOpenOnClick="True"
              />
              <MenuItem
                Name="sendByCtrlEnterMenuItem"
                Click="SendByCtrlEnterMenuItem_Click"
                Header="{DynamicResource SendByCtrlEnter}"
                IsCheckable="True"
                StaysOpenOnClick="True"
              />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>
    </Grid>

    <!--  发送记录弹层：固定宽度；列表最多 240px 内滚动，底栏（记录上限/清空）始终可见  -->
    <Popup
      Name="sendHistoryPopup"
      AllowsTransparency="True"
      Opened="SendHistoryPopup_Opened"
      Placement="Top"
      PlacementTarget="{Binding ElementName=sendHistoryButton}"
      PopupAnimation="Fade"
      StaysOpen="False"
      VerticalOffset="-4"
    >
      <Border
        Width="340"
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="1"
        SnapsToDevicePixels="True"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock
            Grid.Row="0"
            Margin="10,8,10,4"
            FontWeight="Bold"
            Text="{DynamicResource SendHistory}"
          />
          <Grid Grid.Row="1" Margin="6,0,6,0">
            <ListBox
              Name="sendHistoryList"
              MinHeight="36"
              MaxHeight="240"
              Background="Transparent"
              BorderThickness="0"
              ItemsSource="{Binding SendHistory}"
              PreviewMouseLeftButtonUp="SendHistoryList_PreviewMouseLeftButtonUp"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.ScrollUnit="Pixel"
              VirtualizingPanel.VirtualizationMode="Recycling"
            >
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="4,3" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Focusable" Value="False" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock
                    Text="{Binding Converter={StaticResource SendHistoryPreview}}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    ToolTip="{Binding}"
                  />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock
              Margin="6"
              Foreground="{DynamicResource Brush.Foreground.Muted}"
              IsHitTestVisible="False"
              Text="{DynamicResource SendHistoryEmpty}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Items.Count, ElementName=sendHistoryList}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <Border
            Grid.Row="2"
            Padding="10,6"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="0,1,0,0"
          >
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="{DynamicResource SendHistoryLimit}" />
                <TextBox
                  Name="historyLimitBox"
                  Width="52"
                  Height="26"
                  Margin="6,0,4,0"
                  VerticalContentAlignment="Center"
                  DataObject.Pasting="HistoryLimitBox_Pasting"
                  LostFocus="HistoryLimitBox_LostFocus"
                  PreviewKeyDown="HistoryLimitBox_PreviewKeyDown"
                  PreviewTextInput="HistoryLimitBox_PreviewTextInput"
                  TextAlignment="Center"
                  ToolTip="{DynamicResource SendHistoryLimitTip}"
                />
                <TextBlock
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource Brush.Foreground.Muted}"
                  Text="5~200"
                />
              </StackPanel>
              <Button
                Name="clearSendHistoryButton"
                Grid.Column="1"
                Height="26"
                Padding="8,0"
                Click="ClearSendHistoryButton_Click"
                Content="{DynamicResource ClearSendHistory}"
                ToolTip="{DynamicResource ClearSendHistoryTip}"
              />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Popup>

    <!--  底部状态栏：连接状态 · 端口 · 波特率  |  收发计数  -->
    <DockPanel Grid.Row="3" Grid.ColumnSpan="3">
      <StatusBar DockPanel.Dock="Bottom">
        <StatusBar.ItemsPanel>
          <ItemsPanelTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
            </Grid>
          </ItemsPanelTemplate>
        </StatusBar.ItemsPanel>
        <StatusBarItem Grid.Column="0">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource Brush.Foreground.Muted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPortComboEnabled}" Value="False">
                      <Setter Property="Fill" Value="{DynamicResource Brush.State.Success}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Style="{StaticResource Status.Text}" Text="{Binding StatusText}" />
            <TextBlock Style="{StaticResource Status.Text}" Text="  ·  " />
            <TextBlock Style="{StaticResource Status.Text}" Text="{Binding SelectedPort.PortName}" />
            <TextBlock Style="{StaticResource Status.Text}" Text="  ·  " />
            <TextBlock Style="{StaticResource Status.Text}" Text="{Binding SelectedBaudRate.Display}" />
          </StackPanel>
        </StatusBarItem>
        <StatusBarItem Grid.Column="2">
          <StackPanel Orientation="Horizontal" ToolTip="{DynamicResource ClearCountTip}">
            <TextBlock Style="{StaticResource Status.Text}" Margin="0,0,4,0" Text="↑" />
            <TextBlock
              Name="sentCountTextBlock"
              Style="{StaticResource Status.Text}"
              Cursor="Cross"
              MouseRightButtonDown="sentCountTextBlock_MouseRightButtonDown"
              Text="{Binding SentCount}"
            />
          </StackPanel>
        </StatusBarItem>
        <StatusBarItem Grid.Column="3">
          <StackPanel Orientation="Horizontal" ToolTip="{DynamicResource ClearCountTip}">
            <TextBlock Style="{StaticResource Status.Text}" Margin="0,0,4,0" Text="↓" />
            <TextBlock
              Name="receivedCountTextBlock"
              Style="{StaticResource Status.Text}"
              Cursor="Cross"
              MouseRightButtonDown="receivedCountTextBlock_MouseRightButtonDown"
              Text="{Binding ReceivedCount}"
            />
          </StackPanel>
        </StatusBarItem>
      </StatusBar>
    </DockPanel>

    <!--  左右面板之间的可拖拽分隔条  -->
    <GridSplitter
      Grid.Row="0"
      Grid.Column="1"
      Width="6"
      HorizontalAlignment="Stretch"
      Cursor="SizeWE"
      ResizeBehavior="PreviousAndNext"
    >
      <GridSplitter.Style>
        <Style TargetType="GridSplitter">
          <Setter Property="Background" Value="Transparent" />
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource Brush.Surface.Muted}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </GridSplitter.Style>
    </GridSplitter>

    <!--  右侧脚本、快捷发送  -->
    <TabControl
      Grid.Row="0"
      Grid.Column="2"
      Margin="0,6,0,0"
      Background="{DynamicResource Brush.Surface}"
    >
      <!--  串口设置（原顶栏串口控制移入此页，置于最左）  -->
      <TabItem Header="{DynamicResource SerialSettingsCard}">
        <ScrollViewer>
          <StackPanel Margin="8">
            <!--  端口：刷新 + 选择  -->
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button
                Name="refreshPortButton"
                Style="{StaticResource IconButton}"
                Command="{Binding RefreshPortsCommand}"
                IsEnabled="{Binding ElementName=serialPortsListComboBox, Path=IsEnabled}"
                ToolTip="{DynamicResource RefreshPortButton}"
              >
                <fa:FontAwesome Foreground="{DynamicResource Brush.State.Success}" Icon="Refresh" />
              </Button>
              <ComboBox
                Name="serialPortsListComboBox"
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                DisplayMemberPath="DisplayName"
                IsEnabled="{Binding IsPortComboEnabled}"
                ItemsSource="{Binding Ports}"
                SelectedItem="{Binding SelectedPort}"
              />
            </Grid>

            <!--  串口参数：左侧标签列统一宽度，右侧控件左对齐  -->
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="84" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,8,8"
                VerticalAlignment="Center"
                Text="{DynamicResource ShowBaudRate}"
              />
              <ComboBox
                Name="baudRateComboBox"
                Grid.Row="0"
                Grid.Column="1"
                Height="28"
                Margin="0,0,0,8"
                VerticalAlignment="Center"
                DisplayMemberPath="Display"
                ItemsSource="{Binding BaudRates}"
                SelectedItem="{Binding SelectedBaudRate}"
              />

              <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,8,8"
                VerticalAlignment="Center"
                Text="{DynamicResource SettingDataBits}"
              />
              <ComboBox
                Name="mainDataBitsComboBox"
                Grid.Row="1"
                Grid.Column="1"
                Height="28"
                Margin="0,0,0,8"
                VerticalAlignment="Center"
                SelectionChanged="MainDataBitsComboBox_SelectionChanged"
              >
                <ComboBoxItem Content="5" />
                <ComboBoxItem Content="6" />
                <ComboBoxItem Content="7" />
                <ComboBoxItem Content="8" />
              </ComboBox>

              <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,0,8,8"
                VerticalAlignment="Center"
                Text="{DynamicResource SettingParity}"
              />
              <ComboBox
                Name="mainDataCheckComboBox"
                Grid.Row="2"
                Grid.Column="1"
                Height="28"
                Margin="0,0,0,8"
                VerticalAlignment="Center"
                SelectionChanged="MainDataCheckComboBox_SelectionChanged"
              >
                <ComboBoxItem Content="{DynamicResource SettingParityNone}" />
                <ComboBoxItem Content="{DynamicResource SettingParityOdd}" />
                <ComboBoxItem Content="{DynamicResource SettingParityEven}" />
                <ComboBoxItem Content="{DynamicResource SettingParityMark}" />
                <ComboBoxItem Content="{DynamicResource SettingParitySpace}" />
              </ComboBox>

              <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Margin="0,0,8,8"
                VerticalAlignment="Center"
                Text="{DynamicResource SettingStopBit}"
              />
              <ComboBox
                Name="mainStopBitComboBox"
                Grid.Row="3"
                Grid.Column="1"
                Height="28"
                Margin="0,0,0,8"
                VerticalAlignment="Center"
                SelectionChanged="MainStopBitComboBox_SelectionChanged"
              >
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="1.5" />
              </ComboBox>

              <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="{DynamicResource Encoding}"
              />
              <ComboBox
                Name="mainEncodingComboBox"
                Grid.Row="4"
                Grid.Column="1"
                Height="28"
                VerticalAlignment="Center"
                SelectionChanged="MainEncodingComboBox_SelectionChanged"
              />
            </Grid>

            <CheckBox
              Margin="0,0,0,8"
              Content="{DynamicResource SettingAutoReconnect}"
              IsChecked="{Binding Setting.autoReconnect}"
            />
            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
              <CheckBox
                Content="RTS"
                IsChecked="{Binding Rts, Mode=TwoWay}"
                ToolTip="{DynamicResource RTSTip}"
              />
              <CheckBox
                Margin="16,0,0,0"
                Content="DTR"
                IsChecked="{Binding Dtr, Mode=TwoWay}"
                ToolTip="{DynamicResource DTRTip}"
              />
            </StackPanel>
            <Button
              Name="openClosePortButton"
              Height="34"
              HorizontalAlignment="Stretch"
              Command="{Binding OpenClosePortCommand}"
              Style="{StaticResource PortToggleButton}"
            >
              <WrapPanel>
                <TextBlock Text="{Binding OpenCloseButtonText}" />
                <TextBlock Text="{DynamicResource OpenPort_port}" />
              </WrapPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource QuickSendCard}" />
            <Menu Grid.Column="1" HorizontalAlignment="Left">
              <MenuItem
                ToolTip="{DynamicResource QuickSendChangeList}"
                ItemsSource="{Binding QuickSend.Pages}"
              >
                <MenuItem.Header>
                  <Grid>
                    <fa:FontAwesome Foreground="{DynamicResource Brush.Icon.NoteBack}" Icon="StickyNote" />
                    <fa:FontAwesome Foreground="{DynamicResource Brush.Foreground}" Icon="StickyNoteOutline" />
                  </Grid>
                </MenuItem.Header>
                <!-- 页面切换：动态绑定 10 页（QuickSendViewModel.Pages），点击直接切换 -->
                <MenuItem.ItemContainerStyle>
                  <Style TargetType="MenuItem">
                    <Setter Property="Header" Value="{Binding Name}" />
                    <Setter
                      Property="Command"
                      Value="{Binding DataContext.QuickSend.SwitchPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    />
                    <Setter Property="CommandParameter" Value="{Binding Index}" />
                  </Style>
                </MenuItem.ItemContainerStyle>
              </MenuItem>
            </Menu>
          </StackPanel>
        </TabItem.Header>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
          </Grid.RowDefinitions>
          <Grid.Resources>
            <Style x:Key="toSendListStyle" TargetType="{x:Type ListBoxItem}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Name="ItemGrid" Margin="0,3,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="26" />
                      </Grid.ColumnDefinitions>
                      <Grid
                        Margin="1"
                        Background="{DynamicResource Brush.Surface.Subtle}"
                        Cursor="Cross"
                        MouseRightButtonDown="TextBlock_MouseRightButtonDown"
                        Tag="{Binding}"
                      />
                      <TextBlock
                        Grid.Column="0"
                        Margin="4"
                        HorizontalAlignment="Center"
                        Cursor="Cross"
                        MouseRightButtonDown="TextBlock_MouseRightButtonDown"
                        Tag="{Binding}"
                        Text="{Binding id}"
                        ToolTip="{DynamicResource QuickSendIdTip}"
                      />
                      <TextBox
                        Grid.Column="1"
                        Margin="0,0,2,0"
                        HorizontalAlignment="Stretch"
                        Text="{Binding text, UpdateSourceTrigger=PropertyChanged}"
                      />
                      <Button
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Click="knowSendDataButton_click"
                        Content="{Binding commit}"
                        Cursor="Cross"
                        MouseRightButtonDown="Button_MouseDoubleClick"
                        Tag="{Binding}"
                        ToolTip="{DynamicResource QuickSendButtonTip}"
                      />
                      <CheckBox
                        Grid.Column="3"
                        Margin="4"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource QuickSendHex}"
                        IsChecked="{Binding hex}"
                      />
                      <!--  定时发送：折叠在下拉里（和主发送框一样）  -->
                      <Button
                        Grid.Column="5"
                        Width="24"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource QuickSendTimer}"
                        Click="QuickTimerButton_Click"
                        ToolTip="{DynamicResource QuickSendTimerTip}"
                      >
                        <fa:FontAwesome Icon="ClockOutline" FontSize="12">
                          <fa:FontAwesome.Style>
                            <Style TargetType="fa:FontAwesome">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Muted}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding timerEnabled}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource Brush.State.Success}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </fa:FontAwesome.Style>
                        </fa:FontAwesome>
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem
                              Header="{DynamicResource QuickSendTimer}"
                              IsCheckable="True"
                              IsChecked="{Binding timerEnabled}"
                              StaysOpenOnClick="True"
                            />
                            <MenuItem StaysOpenOnClick="True">
                              <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                  <Button
                                    Width="24"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="QuickTimerIntervalMinus_Click"
                                    Content="－"
                                    Cursor="Hand"
                                  />
                                  <TextBlock
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource QuickSendInterval}"
                                  />
                                  <TextBox
                                    Width="72"
                                    VerticalAlignment="Center"
                                    Text="{Binding timerIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="{DynamicResource QuickSendIntervalTip}"
                                    LostFocus="QuickTimerIntervalBox_LostFocus"
                                  />
                                  <Button
                                    Width="24"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="QuickTimerIntervalPlus_Click"
                                    Content="＋"
                                    Cursor="Hand"
                                  />
                                </StackPanel>
                              </MenuItem.Header>
                            </MenuItem>
                          </ContextMenu>
                        </Button.ContextMenu>
                      </Button>
                      <TextBlock
                        Name="recvScriptSet"
                        Grid.Column="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="{Binding recvScriptPath, Converter={StaticResource rsOpacityConverter}}"
                        MouseLeftButtonDown="ScriptIcon_Click"
                        MouseRightButtonDown="ScriptIcon_RightClick"
                        Tag="{Binding}"
                      >
                        <fa:FontAwesome Foreground="{DynamicResource Brush.Foreground.Muted}" Icon="FileText">
                          <fa:FontAwesome.Style>
                            <Style TargetType="fa:FontAwesome">
                              <Setter Property="FontSize" Value="16" />
                              <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter Property="FontSize" Value="20" />
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </fa:FontAwesome.Style>
                        </fa:FontAwesome>
                        <TextBlock.ToolTip>
                          <MultiBinding Converter="{StaticResource rsToolTipConverter}">
                            <Binding Path="recvScriptPath" UpdateSourceTrigger="PropertyChanged" />
                            <Binding
                              ElementName="sendDataButton"
                              Path="Content"
                              UpdateSourceTrigger="PropertyChanged"
                              Delay="1000"
                            />
                          </MultiBinding>
                        </TextBlock.ToolTip>
                      </TextBlock>
                      <TextBlock
                        Visibility="Collapsed"
                        Name="recvScriptPara"
                        Grid.Column="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="{Binding recvScriptPara, Converter={StaticResource rsOpacityConverter}}"
                        MouseLeftButtonUp="ScriptParaIcon_Click"
                        MouseRightButtonDown="ScriptParaIcon_RightClick"
                        Tag="{Binding}"
                        ToolTip="{DynamicResource QuickSendRecvScriptParaSet}"
                      >
                        <fa:FontAwesome Foreground="{DynamicResource Brush.Foreground.Muted}" Icon="Cog">
                          <fa:FontAwesome.Style>
                            <Style TargetType="fa:FontAwesome">
                              <Setter Property="FontSize" Value="18" />
                              <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter Property="FontSize" Value="22" />
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </fa:FontAwesome.Style>
                        </fa:FontAwesome>
                      </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="true">
                        <Setter TargetName="ItemGrid" Property="Background" Value="Transparent" />
                      </Trigger>
                      <Trigger Property="Selector.IsSelected" Value="true">
                        <Setter TargetName="ItemGrid" Property="Background" Value="Transparent" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Grid.Resources>
          <!--  当前页名（单独一行，避免窄宽度时与列标题“内容”重叠）  -->
          <StackPanel
            Name="QuickListNameStackPanel"
            HorizontalAlignment="Left"
            Background="{DynamicResource Brush.Surface.Subtle}"
            Cursor="Cross"
            MouseRightButtonDown="QuickListNameStackPanel_MouseRightButtonDown"
            Orientation="Horizontal"
            ToolTip="{DynamicResource QuickSendListNameTip}"
          >
            <TextBlock Text="(" />
            <TextBlock Name="QuickListPageTextBlock" Text="{Binding QuickSend.CurrentPageName}" />
            <TextBlock Text=")" />
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="30" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="25" />
              <ColumnDefinition Width="25" />
              <ColumnDefinition Width="26" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              HorizontalAlignment="Center"
              Text="{DynamicResource QuickSendId}"
            />
            <TextBlock
              Grid.Column="1"
              HorizontalAlignment="Center"
              Text="{DynamicResource QuickSendContent}"
            />
            <TextBlock
              Grid.Column="3"
              HorizontalAlignment="Center"
              Text="{DynamicResource QuickSendHex}"
            />
            <TextBlock
              Grid.Column="4"
              HorizontalAlignment="Center"
              Text="{DynamicResource QuickSendRecvScript}"
            />
            <TextBlock
              Grid.Column="5"
              HorizontalAlignment="Center"
              Text="{DynamicResource QuickSendTimer}"
              ToolTip="{DynamicResource QuickSendTimerTip}"
            />
          </Grid>
          <ListBox
            Name="toSendList"
            Grid.Row="2"
            ItemsSource="{Binding QuickSend.Items}"
            ItemContainerStyle="{StaticResource toSendListStyle}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.CacheLength="1,2"
            VirtualizingPanel.CacheLengthUnit="Page"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
          />
          <Popup Name="recvScriptPopup" Placement="Bottom" VerticalOffset="5" StaysOpen="True">
            <ComboBox
              Name="recvScriptCombo"
              Width="250"
              DropDownClosed="recvScriptCombo_DropDownClosed"
            />
          </Popup>
          <Popup Name="recvScriptParaPopup" Placement="Bottom" VerticalOffset="5" StaysOpen="False">
            <Grid Background="{DynamicResource Brush.Surface}">
              <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <avalonEdit:TextEditor
                  xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
                  Name="recvScriptParaBox"
                  Margin="3"
                  Width="250"
                  Height="100"
                  WordWrap="True"
                  HorizontalContentAlignment="Left"
                  VerticalContentAlignment="Top"
                  VerticalScrollBarVisibility="Visible"
                />
              </Border>
              <Grid
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,1,3,0"
                Background="Transparent"
              >
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Name="rsParaConfirm"
                  Grid.Column="0"
                  Tag="{Binding ElementName=recvScriptParaBox}"
                  MouseLeftButtonUp="ScriptParaConfirm_Click"
                >
                  <fa:FontAwesome Icon="Check" Foreground="{DynamicResource Brush.State.Success}" FontSize="18" />
                  <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="Opacity" Value="0.25" />
                      <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Opacity" Value="0.8" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock
                  Name="rsParaCancel"
                  Grid.Column="1"
                  MouseLeftButtonUp="ScriptParaCancel_Click"
                >
                  <fa:FontAwesome Icon="Times" Foreground="{DynamicResource Brush.State.Error}" FontSize="18" />
                  <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="Opacity" Value="0.25" />
                      <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Opacity" Value="0.8" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Grid>
          </Popup>
          <StackPanel Grid.Row="3">
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button
                Name="addSendListButton"
                Margin="3"
                Command="{Binding QuickSend.AddCommand}"
                Content="{DynamicResource QuickSendAdd}"
              />
              <Button
                Name="deleteSendListButton"
                Grid.Column="1"
                Margin="3"
                Command="{Binding QuickSend.RemoveLastCommand}"
                Content="{DynamicResource QuickSendRemoveLast}"
              />
            </Grid>
            <TextBlock
              FontWeight="Bold"
              Text="{DynamicResource QuickSendTip}"
              TextWrapping="Wrap"
            />
            <Grid Margin="0,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button
                Name="QuickSendImportButton"
                Margin="3"
                Command="{Binding QuickSend.ImportCommand}"
                Content="{DynamicResource QuickSendImport}"
              />
              <Button
                Name="QuickSendExportButton"
                Grid.Column="1"
                Margin="3"
                Command="{Binding QuickSend.ExportCommand}"
                Content="{DynamicResource QuickSendExport}"
              />
            </Grid>
            <Grid Margin="0,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button
                Name="removeAllButton"
                Grid.Column="0"
                Margin="3"
                Command="{Binding QuickSend.RemoveAllCommand}"
                Content="{DynamicResource QuickSendRemoveAll}"
              />
              <Button
                Name="importSSCOMButton"
                Grid.Column="1"
                Margin="3"
                Command="{Binding QuickSend.ImportSSCOMCommand}"
                Content="{DynamicResource QuickSendImportSSCOM}"
              />
            </Grid>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="{DynamicResource LuaCard}">
        <Grid>
          <!--  脚本编辑界面  -->
          <Grid Name="luaScriptEditorGrid" Visibility="Visible">
            <Grid.RowDefinitions>
              <RowDefinition Height="auto" />
              <RowDefinition Height="auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,5" Orientation="Horizontal">
              <ComboBox
                Name="luaFileList"
                Width="150"
                ItemsSource="{Binding LuaEditor.Files}"
                SelectedItem="{Binding LuaEditor.SelectedFile}"
              />
              <Button
                Name="newScriptButton"
                Style="{StaticResource IconButton}"
                Margin="3,0,0,0"
                Click="NewScriptButton_Click"
                ToolTip="{DynamicResource LuaNewScript}"
              >
                <Grid>
                  <fa:FontAwesome Foreground="{DynamicResource Brush.Icon.New}" Icon="File" />
                  <fa:FontAwesome Icon="FileCodeOutline" />
                </Grid>
              </Button>
              <Button
                Name="runScriptButton"
                Style="{StaticResource IconButton}"
                Margin="2,0,0,0"
                Click="RunScriptButton_Click"
                ToolTip="{DynamicResource LuaRunScript}"
              >
                <fa:FontAwesome Foreground="{DynamicResource Brush.Icon.Run}" Icon="Play" />
              </Button>
              <Button
                Name="openScriptFolderButton"
                Style="{StaticResource IconButton}"
                Margin="2,0,0,0"
                Click="OpenScriptFolderButton_Click"
                ToolTip="{DynamicResource LuaOpenFolder}"
              >
                <Grid>
                  <fa:FontAwesome Foreground="{DynamicResource Brush.Icon.Folder}" Icon="FolderOpen" />
                  <fa:FontAwesome Icon="FolderOutlinepenOutline" />
                </Grid>
              </Button>
              <Button
                Name="refreshScriptListButton"
                Style="{StaticResource IconButton}"
                Margin="2,0,0,0"
                Click="RefreshScriptListButton_Click"
                ToolTip="{DynamicResource LuaRefreshList}"
              >
                <fa:FontAwesome Foreground="{DynamicResource Brush.State.Success}" Icon="Refresh" />
              </Button>
              <Button
                Name="apiDocumentButton"
                Style="{StaticResource IconButton}"
                Margin="2,0,0,0"
                Click="ApiDocumentButton_Click"
                ToolTip="{DynamicResource LuaApiReference}"
              >
                <fa:FontAwesome Foreground="{DynamicResource Brush.Icon.Doc}" Icon="Book" />
              </Button>
              <Button
                Name="scriptShareButton"
                Style="{StaticResource IconButton}"
                Margin="2,0,0,0"
                Click="ScriptShareButton_Click"
                ToolTip="{DynamicResource LuaGetShare}"
              >
                <fa:FontAwesome Foreground="{DynamicResource Brush.Accent.Teal}" Icon="ShareAlt" />
              </Button>
            </WrapPanel>
            <WrapPanel Name="newLuaFileWrapPanel" Grid.Row="1" Margin="3" Visibility="Collapsed">
              <TextBlock VerticalAlignment="Center" Text="{DynamicResource LuaFileName}" />
              <TextBox Name="newLuaFileNameTextBox" Width="90" Text="new script" />
              <Button
                Name="newLuaFilebutton"
                Style="{StaticResource IconButton}"
                Margin="3,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="NewLuaFilebutton_Click"
                ToolTip="{DynamicResource LuaConfirmCreate}"
              >
                <fa:FontAwesome Foreground="{DynamicResource Brush.State.Success}" Icon="Check" />
              </Button>
              <Button
                Name="newLuaFileCancelbutton"
                Style="{StaticResource IconButton}"
                Margin="3,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="NewLuaFileCancelbutton_Click"
                ToolTip="{DynamicResource LuaCancel}"
              >
                <fa:FontAwesome Foreground="{DynamicResource Brush.State.Error}" Icon="Ban" />
              </Button>
            </WrapPanel>
            <avalonEdit:TextEditor
              xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
              Name="textEditor"
              Grid.Row="2"
              FontFamily="Consolas"
              FontSize="10pt"
              LostFocus="TextEditor_LostFocus"
              ShowLineNumbers="True"
              TextChanged="textEditor_TextChanged"
            />
          </Grid>
          <!--  脚本编辑界面END  -->

          <!--  脚本运行日志界面  -->
          <Grid Name="luaLogShowGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <TextBox
              Name="luaLogTextBox"
              VerticalContentAlignment="Top"
              IsReadOnly="true"
              IsUndoEnabled="False"
              MouseLeave="luaLogTextBox_MouseLeave"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              TextWrapping="NoWrap"
              VerticalScrollBarVisibility="Auto"
            />
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
              </Grid.ColumnDefinitions>
              <Button
                Name="stopLuaButton"
                Style="{StaticResource IconButton}"
                Margin="0,3,3,3"
                Click="StopLuaButton_Click"
                Foreground="{DynamicResource Brush.State.Danger}"
                ToolTip="{DynamicResource LuaStop}"
              >
                <fa:FontAwesome Name="stopLuaOrExitIcon" Icon="Stop" />
              </Button>
              <Button
                Name="pauseLuaPrintButton"
                Style="{StaticResource IconButton}"
                Grid.Column="1"
                Margin="0,3,3,3"
                Click="PauseLuaPrintButton_Click"
                Foreground="{DynamicResource Brush.Icon.Pause}"
                MouseRightButtonUp="pauseLuaPrintButton_MouseRightButtonUp"
                ToolTip="{DynamicResource LuaPause}"
              >
                <fa:FontAwesome Name="pauseLuaPrintIcon" Icon="Pause" />
              </Button>
              <TextBox
                Name="runOneLineLuaTextBox"
                Grid.Column="2"
                Margin="0,3"
                KeyDown="RunOneLineLuaTextBox_KeyDown"
              />
              <Button
                Name="sendLuaScriptButton"
                Style="{StaticResource IconButton}"
                Grid.Column="3"
                Margin="3,3,0,3"
                Click="SendLuaScriptButton_Click"
                Foreground="{DynamicResource Brush.State.Info}"
                ToolTip="{DynamicResource LuaSendScript}"
              >
                <fa:FontAwesome Icon="ArrowUp" />
              </Button>
            </Grid>
          </Grid>
          <!--  脚本运行日志界面END  -->
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <fa:FontAwesome Foreground="{DynamicResource Brush.Accent.Brown}" Icon="cubes" />
        </TabItem.Header>
        <Frame Name="OnlineScriptsFrame" NavigationUIVisibility="Hidden" />
      </TabItem>
      <TabItem Header="{DynamicResource ToolsTab}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ComboBox
            Name="ToolSelector"
            Margin="0,0,0,8"
            SelectionChanged="ToolSelector_SelectionChanged"
          >
            <ComboBoxItem Content="{DynamicResource TcpTabTitle}" />
            <ComboBoxItem Content="{DynamicResource TcpLocalTabTitle}" />
            <ComboBoxItem Content="{DynamicResource UdpLocalTabTitle}" />
            <ComboBoxItem Content="{DynamicResource TcpClientTitle}" />
            <ComboBoxItem Content="{DynamicResource EncodingToolsTab}" />
            <ComboBoxItem Content="MQTT" />
            <ComboBoxItem Content="{DynamicResource EncodingFixHeader}" />
            <ComboBoxItem Content="{DynamicResource SerialMonitorHeader}" />
            <ComboBoxItem Content="{DynamicResource PlotHeader}" />
            <ComboBoxItem Content="WinUSB" />
          </ComboBox>
          <Grid Grid.Row="1">
            <Frame Name="tcpTestFrame" NavigationUIVisibility="Hidden" />
            <Frame
              Name="tcpLocalTestFrame"
              NavigationUIVisibility="Hidden"
              Visibility="Collapsed"
            />
            <Frame
              Name="udpLocalTestFrame"
              NavigationUIVisibility="Hidden"
              Visibility="Collapsed"
            />
            <Frame Name="tcpClientFrame" NavigationUIVisibility="Hidden" Visibility="Collapsed" />
            <Frame
              Name="EncodingToolsFrame"
              NavigationUIVisibility="Hidden"
              Visibility="Collapsed"
            />
            <Frame Name="MqttTestFrame" NavigationUIVisibility="Hidden" Visibility="Collapsed" />
            <Frame Name="EncodingFixFrame" NavigationUIVisibility="Hidden" Visibility="Collapsed" />
            <Frame
              Name="SerialMonitorFrame"
              NavigationUIVisibility="Hidden"
              Visibility="Collapsed"
            />
            <Frame Name="PlotFrame" NavigationUIVisibility="Hidden" Visibility="Collapsed" />
            <Frame Name="WinUSBFrame" NavigationUIVisibility="Hidden" Visibility="Collapsed" />
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="{DynamicResource AboutCard}">
        <Frame Name="aboutFrame" NavigationUIVisibility="Hidden" />
      </TabItem>
    </TabControl>
  </Grid>
</Window>
